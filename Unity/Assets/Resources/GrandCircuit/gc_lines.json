{
  "note": "Round 20 + Round 22 (Grand Circuit; Round 22 = Nela, Viper; QF37 = a Scree, Ratwing (they replace the Machinist and Juniper)): proposed short taunts / cheers in the racers' existing voices (Code, for Dan). Event = when it may play (one line at a time, never more than one every 8 s).",
  "lines": [
    {"id": "GC_7_START", "speaker": "seven", "voice": "seven", "event": "start", "direction": "eager", "text": "Let's fly."},
    {"id": "GC_7_PASS", "speaker": "seven", "voice": "seven", "event": "pass", "direction": "playful", "text": "Excuse me!"},
    {"id": "GC_7_PUSHED", "speaker": "seven", "voice": "seven", "event": "pushed", "direction": "laughing", "text": "Hey! That was my line."},
    {"id": "GC_7_LAST", "speaker": "seven", "voice": "seven", "event": "last", "direction": "focused", "text": "Last lap. Here we go."},
    {"id": "GC_7_WIN", "speaker": "seven", "voice": "seven", "event": "win", "direction": "delighted", "text": "Not bad for a bike."},
    {"id": "GC_D_START", "speaker": "duchess", "voice": "Duchess", "event": "start", "direction": "", "text": "Do try to keep up, darling."},
    {"id": "GC_D_PASS", "speaker": "duchess", "voice": "Duchess", "event": "pass", "direction": "", "text": "Pardon my tail."},
    {"id": "GC_D_PUSHED", "speaker": "duchess", "voice": "Duchess", "event": "pushed", "direction": "", "text": "How very rude!"},
    {"id": "GC_D_LAST", "speaker": "duchess", "voice": "Duchess", "event": "last", "direction": "", "text": "One more lap. Effortless."},
    {"id": "GC_D_WIN", "speaker": "duchess", "voice": "Duchess", "event": "win", "direction": "", "text": "Naturally."},
    {"id": "GC_T_START", "speaker": "tunneler", "voice": "Tunneler", "event": "start", "direction": "", "text": "I dig in straight lines. Stay out of them."},
    {"id": "GC_T_PASS", "speaker": "tunneler", "voice": "Tunneler", "event": "pass", "direction": "", "text": "Make room."},
    {"id": "GC_T_PUSHED", "speaker": "tunneler", "voice": "Tunneler", "event": "pushed", "direction": "", "text": "That tickled."},
    {"id": "GC_T_LAST", "speaker": "tunneler", "voice": "Tunneler", "event": "last", "direction": "", "text": "Last lap. Steady."},
    {"id": "GC_T_WIN", "speaker": "tunneler", "voice": "Tunneler", "event": "win", "direction": "", "text": "Steady wins."},
    {"id": "GC_N_START", "speaker": "nela", "voice": "nela", "event": "start", "direction": "", "text": "Let's see how the stars move today."},
    {"id": "GC_N_PASS", "speaker": "nela", "voice": "nela", "event": "pass", "direction": "", "text": "Forgive me. The way was open."},
    {"id": "GC_N_PUSHED", "speaker": "nela", "voice": "nela", "event": "pushed", "direction": "", "text": "Gently, please."},
    {"id": "GC_N_LAST", "speaker": "nela", "voice": "nela", "event": "last", "direction": "", "text": "Once more around."},
    {"id": "GC_N_WIN", "speaker": "nela", "voice": "nela", "event": "win", "direction": "", "text": "Thank you. That was beautiful."},
    {"id": "GC_V_START", "speaker": "viper", "voice": "Viper", "event": "start", "direction": "", "text": "Try to keep up, little observer."},
    {"id": "GC_V_PASS", "speaker": "viper", "voice": "Viper", "event": "pass", "direction": "", "text": "Out of my way."},
    {"id": "GC_V_PUSHED", "speaker": "viper", "voice": "Viper", "event": "pushed", "direction": "", "text": "You will regret that."},
    {"id": "GC_V_LAST", "speaker": "viper", "voice": "Viper", "event": "last", "direction": "", "text": "Last lap. Your last chance."},
    {"id": "GC_V_WIN", "speaker": "viper", "voice": "Viper", "event": "win", "direction": "", "text": "The serpent always strikes first."},
    {"id": "GC_S_START", "speaker": "scree", "voice": "screeworker", "event": "start", "direction": "", "text": "For the lower districts!"},
    {"id": "GC_S_PASS", "speaker": "scree", "voice": "screeworker", "event": "pass", "direction": "", "text": "Keep up."},
    {"id": "GC_R_START", "speaker": "ratwing", "voice": "ratwing", "event": "start", "direction": "", "text": "Catch me if you can."},
    {"id": "GC_R_DUCHESS", "speaker": "ratwing", "voice": "ratwing", "event": "pass_duchess", "direction": "", "text": "Try to keep your eyes on the road, cat."},
    {"id": "GC_R_WIN", "speaker": "ratwing", "voice": "ratwing", "event": "win", "direction": "", "text": "Shiny trophy… mine."}
  ]
}
