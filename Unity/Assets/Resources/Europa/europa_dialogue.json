 "lines": [
  {
   "id": "EUR_01_01",
   "scene": "EUR_01",
   "speaker": "seven",
   "label": "7",
   "text": "There’s an ocean under all of this.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_01_02",
   "scene": "EUR_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Apparently.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_01_03",
   "scene": "EUR_01",
   "speaker": "seven",
   "label": "7",
   "text": "You don’t sound curious.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_01_04",
   "scene": "EUR_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "I’m curious from here.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_01_05",
   "scene": "EUR_01",
   "speaker": "seven",
   "label": "7",
   "text": "There. A way down.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_01_06",
   "scene": "EUR_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "You said that rather enthusiastically.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_01_07",
   "scene": "EUR_01",
   "speaker": "seven",
   "label": "7",
   "text": "Mm-hmm.",
   "direction": "smiling in her voice",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_02_01",
   "scene": "EUR_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "That is the same bike.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_02_02",
   "scene": "EUR_02",
   "speaker": "seven",
   "label": "7",
   "text": "Yes.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_02_03",
   "scene": "EUR_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "And you’re taking it underwater.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_02_04",
   "scene": "EUR_02",
   "speaker": "seven",
   "label": "7",
   "text": "It works underwater.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_02_05",
   "scene": "EUR_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "I’m pleased one of us knew that.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_02_06",
   "scene": "EUR_02",
   "speaker": "seven",
   "label": "7",
   "text": "Keep an eye on the ship.",
   "direction": "a small laugh",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_02_07",
   "scene": "EUR_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "Happily.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_01",
   "scene": "EUR_03",
   "speaker": "seven",
   "label": "7",
   "text": "Oh…",
   "direction": "softly",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_02",
   "scene": "EUR_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "What is it?",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_03",
   "scene": "EUR_03",
   "speaker": "seven",
   "label": "7",
   "text": "They’re beneath me.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_04",
   "scene": "EUR_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Who?",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_05",
   "scene": "EUR_03",
   "speaker": "seven",
   "label": "7",
   "text": "I think one of the people we came to meet.",
   "direction": "an astonished breath",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_06",
   "scene": "EUR_03",
   "speaker": "seven",
   "label": "7",
   "text": "Did you hear that?",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_07",
   "scene": "EUR_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Through your connection. A little.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_08",
   "scene": "EUR_03",
   "speaker": "seven",
   "label": "7",
   "text": "I wish you could see this.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_03_09",
   "scene": "EUR_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Tell me.",
   "direction": "gently",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_04_01",
   "scene": "EUR_04",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "You followed the old approach.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_04_02",
   "scene": "EUR_04",
   "speaker": "seven",
   "label": "7",
   "text": "The Elarim gave us the location.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_04_03",
   "scene": "EUR_04",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "Then someone still remembers the route.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_04_04",
   "scene": "EUR_04",
   "speaker": "seven",
   "label": "7",
   "text": "We’re looking for your temple.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_04_05",
   "scene": "EUR_04",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "And you have brought other histories with you.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_04_06",
   "scene": "EUR_04",
   "speaker": "seven",
   "label": "7",
   "text": "I’m trying to understand them.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_04_07",
   "scene": "EUR_04",
   "speaker": "seven",
   "label": "7",
   "text": "What was that?",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_04_08",
   "scene": "EUR_04",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "Something that does not belong here.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05R_01",
   "scene": "EUR_05R",
   "speaker": "seven",
   "label": "7",
   "text": "They have races.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05R_02",
   "scene": "EUR_05R",
   "speaker": "cat",
   "label": "Panther",
   "text": "Of course that’s what you noticed.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05R_03",
   "scene": "EUR_05R",
   "speaker": "seven",
   "label": "7",
   "text": "It would help me learn the bike down here.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05R_04",
   "scene": "EUR_05R",
   "speaker": "cat",
   "label": "Panther",
   "text": "A thoroughly educational decision.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05R_05",
   "scene": "EUR_05R",
   "speaker": "seven",
   "label": "7",
   "text": "Exactly.",
   "direction": "laughing",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05O_01",
   "scene": "EUR_05O",
   "speaker": "seven",
   "label": "7",
   "text": "Ha!",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05O_02",
   "scene": "EUR_05O",
   "speaker": "cat",
   "label": "Panther",
   "text": "Was that educational?",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05O_03",
   "scene": "EUR_05O",
   "speaker": "seven",
   "label": "7",
   "text": "Very.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05L_01",
   "scene": "EUR_05L",
   "speaker": "seven",
   "label": "7",
   "text": "I took that turn too wide.",
   "direction": "breathless chuckle",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05L_02",
   "scene": "EUR_05L",
   "speaker": "cat",
   "label": "Panther",
   "text": "The pillar seemed to agree.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05W_01",
   "scene": "EUR_05W",
   "speaker": "cat",
   "label": "Panther",
   "text": "Shall I add professional racing to our itinerary?",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_05W_02",
   "scene": "EUR_05W",
   "speaker": "seven",
   "label": "7",
   "text": "Just visiting the temple will do.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_01",
   "scene": "EUR_06",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "Our young travel through here. Our calls guide them.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_02",
   "scene": "EUR_06",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "Now they cannot hear us.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_03",
   "scene": "EUR_06",
   "speaker": "seven",
   "label": "7",
   "text": "Who built it?",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_04",
   "scene": "EUR_06",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "He calls himself Tunneler.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_05",
   "scene": "EUR_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Oh. Him.",
   "direction": "quietly",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_06",
   "scene": "EUR_06",
   "speaker": "seven",
   "label": "7",
   "text": "We know the name.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_07",
   "scene": "EUR_06",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "He promised to take only what we would not miss.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_08",
   "scene": "EUR_06",
   "speaker": "seven",
   "label": "7",
   "text": "Where is he?",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_09",
   "scene": "EUR_06",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "Below the old shelf. He has brought workers who cannot leave.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_10",
   "scene": "EUR_06",
   "speaker": "seven",
   "label": "7",
   "text": "The Scree?",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_11",
   "scene": "EUR_06",
   "speaker": "keeper",
   "label": "Keeper",
   "text": "Yes.",
   "direction": "",
   "voice": "Keeper",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_06_12",
   "scene": "EUR_06",
   "speaker": "seven",
   "label": "7",
   "text": "Show me the way in.",
   "direction": "firmly",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_07_01",
   "scene": "EUR_07",
   "speaker": "seven",
   "label": "7",
   "text": "They’re working down here too.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_07_02",
   "scene": "EUR_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "Can you reach them?",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_07_03",
   "scene": "EUR_07",
   "speaker": "seven",
   "label": "7",
   "text": "There’s a service entrance.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_07_04",
   "scene": "EUR_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "Find a way out as well.",
   "direction": "",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_07_05",
   "scene": "EUR_07",
   "speaker": "seven",
   "label": "7",
   "text": "I will.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_01",
   "scene": "EUR_08",
   "speaker": "tunneler",
   "label": "Tunneler",
   "text": "You.",
   "direction": "",
   "voice": "Tunneler",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_02",
   "scene": "EUR_08",
   "speaker": "seven",
   "label": "7",
   "text": "You remember me.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_03",
   "scene": "EUR_08",
   "speaker": "tunneler",
   "label": "Tunneler",
   "text": "You were supposed to remain where you were put.",
   "direction": "",
   "voice": "Tunneler",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_04",
   "scene": "EUR_08",
   "speaker": "seven",
   "label": "7",
   "text": "I didn’t like the accommodation.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_05",
   "scene": "EUR_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "Neither did I.",
   "direction": "privately, dryly",
   "voice": "Cat",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_06",
   "scene": "EUR_08",
   "speaker": "tunneler",
   "label": "Tunneler",
   "text": "Leave my operation alone.",
   "direction": "",
   "voice": "Tunneler",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_07",
   "scene": "EUR_08",
   "speaker": "seven",
   "label": "7",
   "text": "Your machinery is closing their routes. Your workers can’t leave.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_08",
   "scene": "EUR_08",
   "speaker": "tunneler",
   "label": "Tunneler",
   "text": "My workers have obligations.",
   "direction": "",
   "voice": "Tunneler",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_09",
   "scene": "EUR_08",
   "speaker": "seven",
   "label": "7",
   "text": "Then you can explain them when the doors are open.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_10",
   "scene": "EUR_08",
   "speaker": "tunneler",
   "label": "Tunneler",
   "text": "You have no idea what it takes to keep all of this running.",
   "direction": "",
   "voice": "Tunneler",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_08_11",
   "scene": "EUR_08",
   "speaker": "seven",
   "label": "7",
   "text": "I’m starting to.",
   "direction": "",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_09_01",
   "scene": "EUR_09",
   "speaker": "scree",
   "label": "Scree worker",
   "text": "Where are we being taken?",
   "direction": "",
   "voice": "scree",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_09_02",
   "scene": "EUR_09",
   "speaker": "seven",
   "label": "7",
   "text": "Out.",
   "direction": "gently",
   "voice": "Seven",
   "delivery": "",
   "cue": ""
  },
  {
   "id": "EUR_09_03",
   "scene": "EUR_09",
   "speaker": "scree",
   "label": "Scree worker",
