 ],
 "lines": [
  {
   "id": "CAT_01_01",
   "scene": "CAT_01",
   "speaker": "seven",
   "label": "7",
   "text": "You’ve been sitting up for the last ten minutes.",
   "direction": "",
   "action": "Looks down at him.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_01_02",
   "scene": "CAT_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Have I?",
   "direction": "",
   "action": "Still watching outside.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_01_03",
   "scene": "CAT_01",
   "speaker": "seven",
   "label": "7",
   "text": "Mm-hmm.",
   "direction": "A small smile in her voice",
   "action": "A small smile in her voice.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_01_04",
   "scene": "CAT_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "That’s the old transit tower.",
   "direction": "",
   "action": "Ears lift.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_01_05",
   "scene": "CAT_01",
   "speaker": "seven",
   "label": "7",
   "text": "The one with the ball hanging from it?",
   "direction": "",
   "action": "Leans forward.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_01_06",
   "scene": "CAT_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Yes.",
   "direction": "",
   "action": "Completely ordinary to him.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_01_07",
   "scene": "CAT_01",
   "speaker": "seven",
   "label": "7",
   "text": "Of course.",
   "direction": "Quiet laugh",
   "action": "Quiet laugh.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_01_08",
   "scene": "CAT_01",
   "speaker": "seven",
   "label": "7",
   "text": "Is that building cardboard?",
   "direction": "",
   "action": "Studies the view.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_01_09",
   "scene": "CAT_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Several buildings, actually.",
   "direction": "Mild pride",
   "action": "Mild pride.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_01_10",
   "scene": "CAT_01",
   "speaker": "seven",
   "label": "7",
   "text": "And the enormous tree?",
   "direction": "",
   "action": "Looks upward.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_01_11",
   "scene": "CAT_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Apartments. The upper platforms are expensive.",
   "direction": "Matter-of-fact",
   "action": "Matter-of-fact.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_01_12",
   "scene": "CAT_01",
   "speaker": "seven",
   "label": "7",
   "text": "Better view?",
   "direction": "",
   "action": "Glances down.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_01_13",
   "scene": "CAT_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Better sun.",
   "direction": "",
   "action": "Settles briefly.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_01_14",
   "scene": "CAT_01",
   "speaker": "seven",
   "label": "7",
   "text": "Ah. Obviously.",
   "direction": "Small giggle",
   "action": "Small giggle.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_02_01",
   "scene": "CAT_02",
   "speaker": "seven",
   "label": "7",
   "text": "Is he going in?",
   "direction": "Quietly to Panther",
   "action": "Quietly to Panther.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_02_02",
   "scene": "CAT_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "He wanted it open.",
   "direction": "",
   "action": "Watches the cat settle.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_02_03",
   "scene": "CAT_02",
   "speaker": "seven",
   "label": "7",
   "text": "Oh. Not to go through.",
   "direction": "",
   "action": "A beat.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_02_04",
   "scene": "CAT_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "That’s a separate decision.",
   "direction": "",
   "action": "Begins walking.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_02_05",
   "scene": "CAT_02",
   "speaker": "seven",
   "label": "7",
   "text": "Right. I’ll try to keep up.",
   "direction": "Soft laugh",
   "action": "Soft laugh; follows.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_02_06",
   "scene": "CAT_02",
   "speaker": "seven",
   "label": "7",
   "text": "Don’t even think about it.",
   "direction": "Amused",
   "action": "Amused; folds her arms.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_02_07",
   "scene": "CAT_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "I’m assessing the workmanship.",
   "direction": "",
   "action": "Places one paw inside.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_02_08",
   "scene": "CAT_02",
   "speaker": "seven",
   "label": "7",
   "text": "With your feet?",
   "direction": "Suppressed giggle",
   "action": "Suppressed giggle.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_02_09",
   "scene": "CAT_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "Thoroughly.",
   "direction": "",
   "action": "Places a second paw inside.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_03_01",
   "scene": "CAT_03",
   "speaker": "juniper",
   "label": "Juniper",
   "text": "Panther? Well, look who finally came back.",
   "direction": "",
   "action": "Approaches with tail raised.",
   "voice": "juniper",
   "repeat": false
  },
  {
   "id": "CAT_03_02",
   "scene": "CAT_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Hello.",
   "direction": "Warm, slightly guarded",
   "action": "Warm, slightly guarded.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_03_03",
   "scene": "CAT_03",
   "speaker": "juniper",
   "label": "Juniper",
   "text": "And you found her.",
   "direction": "",
   "action": "Looks up at 7.",
   "voice": "juniper",
   "repeat": false
  },
  {
   "id": "CAT_03_04",
   "scene": "CAT_03",
   "speaker": "seven",
   "label": "7",
   "text": "You knew about me?",
   "direction": "",
   "action": "Kneels comfortably.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_03_05",
   "scene": "CAT_03",
   "speaker": "juniper",
   "label": "Juniper",
   "text": "Only that he wouldn’t leave the assignment alone until they gave it to him.",
   "direction": "Affectionate teasing",
   "action": "Affectionate teasing.",
   "voice": "juniper",
   "repeat": false
  },
  {
   "id": "CAT_03_06",
   "scene": "CAT_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Ahem.",
   "direction": "",
   "action": "Looks toward the street.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_03_07",
   "scene": "CAT_03",
   "speaker": "juniper",
   "label": "Juniper",
   "text": "What? You did.",
   "direction": "Innocent amusement",
   "action": "Innocent amusement.",
   "voice": "juniper",
   "repeat": false
  },
  {
   "id": "CAT_03_08",
   "scene": "CAT_03",
   "speaker": "seven",
   "label": "7",
   "text": "You volunteered?",
   "direction": "",
   "action": "Turns to Panther.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_03_09",
   "scene": "CAT_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "There was an opening.",
   "direction": "Carefully casual",
   "action": "Carefully casual.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_03_10",
   "scene": "CAT_03",
   "speaker": "juniper",
   "label": "Juniper",
   "text": "Mm-hmm.",
   "direction": "A knowing hum",
   "action": "A knowing hum.",
   "voice": "juniper",
   "repeat": false
  },
  {
   "id": "CAT_03_11",
   "scene": "CAT_03",
   "speaker": "seven",
   "label": "7",
   "text": "You told me you were sent.",
   "direction": "Curious, not accusing",
   "action": "Curious, not accusing.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_03_12",
   "scene": "CAT_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "I was.",
   "direction": "",
   "action": "Looks up.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_03_13",
   "scene": "CAT_03",
   "speaker": "seven",
   "label": "7",
   "text": "After you asked.",
   "direction": "Small smile",
   "action": "Small smile.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_03_14",
   "scene": "CAT_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Yes.",
   "direction": "",
   "action": "A pause.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_03_15",
   "scene": "CAT_03",
   "speaker": "seven",
   "label": "7",
   "text": "Why?",
   "direction": "Quietly",
   "action": "Quietly.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_03_16",
   "scene": "CAT_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Someone needed help. I thought I could help.",
   "direction": "Plain and sincere",
   "action": "Plain and sincere.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_03_17",
   "scene": "CAT_03",
   "speaker": "seven",
   "label": "7",
   "text": "And afterward? Nobody asked you to stay.",
   "direction": "",
   "action": "Her hand rests beside him.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_03_18",
   "scene": "CAT_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "No.",
   "direction": "",
   "action": "Meets her gaze.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_03_19",
   "scene": "CAT_03",
   "speaker": "seven",
   "label": "7",
   "text": "I’m glad you did.",
   "direction": "Softly",
   "action": "Softly.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_03_20",
   "scene": "CAT_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "So am I.",
   "direction": "",
   "action": "Leans against her hand.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_04_01",
   "scene": "CAT_04",
   "speaker": "announcer",
   "label": "Announcer",
   "text": "The Cattalus Grand Circuit! Registration closes this afternoon!",
   "direction": "Sporting enthusiasm",
   "action": "Sporting enthusiasm.",
   "voice": "TeedOff Barker",
   "repeat": false
  },
  {
   "id": "CAT_04_02",
   "scene": "CAT_04",
   "speaker": "announcer",
   "label": "Announcer",
   "text": "One champion. One magnificent trophy!",
   "direction": "",
   "action": "Trophy rotates.",
   "voice": "TeedOff Barker",
   "repeat": false
  },
  {
   "id": "CAT_04_03",
   "scene": "CAT_04",
   "speaker": "seven",
   "label": "7",
   "text": "Panther.",
   "direction": "",
   "action": "Stops walking.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_04_04",
   "scene": "CAT_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "I see it.",
   "direction": "",
   "action": "Steps closer.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_04_05",
   "scene": "CAT_04",
   "speaker": "seven",
   "label": "7",
   "text": "The setting. That mark…",
   "direction": "",
   "action": "Recognizes a symbol shared with their records.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_04_06",
   "scene": "CAT_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "The last piece.",
   "direction": "",
   "action": "Studies the display.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_04_07",
   "scene": "CAT_04",
   "speaker": "seven",
   "label": "7",
   "text": "In a racing trophy?",
   "direction": "Disbelieving little laugh",
   "action": "Disbelieving little laugh.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_04_08",
   "scene": "CAT_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "Apparently.",
   "direction": "",
   "action": "A pause.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_04_09",
   "scene": "CAT_04",
   "speaker": "announcer",
   "label": "Announcer",
   "text": "And for our runner-up: the Deluxe Retreat! Premium corrugation! Packing paper included!",
   "direction": "Absurd grandeur",
   "action": "Absurd grandeur.",
   "voice": "TeedOff Barker",
   "repeat": false
  },
  {
   "id": "CAT_04_11",
   "scene": "CAT_04",
   "speaker": "seven",
   "label": "7",
   "text": "Panther. The sphere.",
   "direction": "",
   "action": "Gently recalls his attention.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_04_12",
   "scene": "CAT_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "Yes. Of course.",
   "direction": "",
   "action": "Clears his throat.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_04_13",
   "scene": "CAT_04",
   "speaker": "seven",
   "label": "7",
   "text": "Heh. Come on.",
   "direction": "",
   "action": "Heads toward registration.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_05_01",
   "scene": "CAT_05",
   "speaker": "seven",
   "label": "7",
   "text": "The sphere in the trophy. Do you know what it is?",
   "direction": "",
   "action": "Indicates the display.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_05_02",
   "scene": "CAT_05",
   "speaker": "steward",
   "label": "Steward",
   "text": "A very old, very beautiful ball.",
   "direction": "Confident",
   "action": "Confident.",
   "voice": "steward",
   "repeat": false
  },
  {
   "id": "CAT_05_03",
   "scene": "CAT_05",
   "speaker": "seven",
   "label": "7",
   "text": "It’s more than that.",
   "direction": "Earnest",
   "action": "Earnest.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_05_04",
   "scene": "CAT_05",
   "speaker": "steward",
   "label": "Steward",
   "text": "You’ll have to speak to its owner after the race.",
   "direction": "",
   "action": "Checks the registration screen.",
   "voice": "steward",
   "repeat": false
  },
  {
   "id": "CAT_05_05",
   "scene": "CAT_05",
   "speaker": "seven",
   "label": "7",
   "text": "And until then?",
   "direction": "",
   "action": "A beat.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_05_06",
   "scene": "CAT_05",
   "speaker": "steward",
   "label": "Steward",
   "text": "We have one place left in the final.",
   "direction": "",
   "action": "Turns the screen toward her.",
   "voice": "steward",
   "repeat": false
  },
  {
   "id": "CAT_05_07",
   "scene": "CAT_05",
   "speaker": "seven",
   "label": "7",
   "text": "Well. We did bring transportation.",
   "direction": "Small excited laugh",
   "action": "Small excited laugh.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_05_08",
   "scene": "CAT_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "Try to keep all of it.",
   "direction": "",
   "action": "Eyes the bike’s front forks.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_05_09",
   "scene": "CAT_05",
   "speaker": "seven",
   "label": "7",
   "text": "You make one dramatic exit from an underwater base—",
   "direction": "Playful protest",
   "action": "Playful protest.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_05_10",
   "scene": "CAT_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "I remember it very clearly.",
   "direction": "Dry",
   "action": "Dry.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_05_11",
   "scene": "CAT_05",
   "speaker": "duchess",
   "label": "Duchess",
   "text": "Is the little shelf removable?",
   "direction": "",
   "action": "Peers inside.",
   "voice": "Duchess",
   "repeat": false
  },
  {
   "id": "CAT_05_12",
   "scene": "CAT_05",
   "speaker": "steward",
   "label": "Steward",
   "text": "Adjustable.",
   "direction": "Professional",
   "action": "Professional.",
   "voice": "steward",
   "repeat": false
  },
  {
   "id": "CAT_05_13",
   "scene": "CAT_05",
   "speaker": "duchess",
   "label": "Duchess",
   "text": "Oh.",
   "direction": "Clearly impressed",
   "action": "Clearly impressed.",
   "voice": "Duchess",
   "repeat": false
  },
  {
   "id": "CAT_06_01",
   "scene": "CAT_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "The high turn after the market tightens halfway through.",
   "direction": "",
   "action": "Watches her checks.",
   "voice": "Cat",
   "repeat": true
  },
  {
   "id": "CAT_06_02",
   "scene": "CAT_06",
   "speaker": "seven",
   "label": "7",
   "text": "You know the course?",
   "direction": "",
   "action": "Looks up.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_06_03",
   "scene": "CAT_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "I know the streets.",
   "direction": "Matter-of-fact",
   "action": "Matter-of-fact.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_06_04",
   "scene": "CAT_06",
   "speaker": "seven",
   "label": "7",
   "text": "Going to talk me around it?",
   "direction": "Warmly",
   "action": "Warmly.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_06_05",
   "scene": "CAT_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "If you’ll listen.",
   "direction": "Mildly pointed",
   "action": "Mildly pointed.",
   "voice": "Cat",
   "repeat": false
  },
  {
   "id": "CAT_06_06",
   "scene": "CAT_06",
   "speaker": "seven",
   "label": "7",
   "text": "Mm. No promises.",
   "direction": "Little giggle",
   "action": "Little giggle.",
   "voice": "Seven",
   "repeat": false
  },
  {
   "id": "CAT_06_07",
   "scene": "CAT_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Comforting.",
