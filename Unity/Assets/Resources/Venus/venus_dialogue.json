  {
   "id": "VEN_C04_13",
   "scene": "VEN_C04",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "We cannot keep repairing the ground while he tears it away.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C04_14",
   "scene": "VEN_C04",
   "speaker": "seven",
   "label": "7",
   "text": "Then I’ll find him.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C04_15",
   "scene": "VEN_C04",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "The creatures are being driven. Please remember that.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C04_16",
   "scene": "VEN_C04",
   "speaker": "seven",
   "label": "7",
   "text": "I will.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C05_01",
   "scene": "VEN_C05",
   "speaker": "seven",
   "label": "7",
   "text": "They aren’t attacking the people.",
   "delivery": "in-gameplay",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C05_02",
   "scene": "VEN_C05",
   "speaker": "cat",
   "label": "Panther",
   "text": "What are they doing?",
   "delivery": "telepathic",
   "voice": "Cat",
   "cue": ""
  },
  {
   "id": "VEN_C05_03",
   "scene": "VEN_C05",
   "speaker": "seven",
   "label": "7",
   "text": "Following something. Every time that sound starts, they move.",
   "delivery": "in-gameplay",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C05_04",
   "scene": "VEN_C05",
   "speaker": "seven",
   "label": "7",
   "text": "There.",
   "delivery": "in-gameplay",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C05_05",
   "scene": "VEN_C05",
   "speaker": "cat",
   "label": "Panther",
   "text": "Then find what’s calling them.",
   "delivery": "telepathic",
   "voice": "Cat",
   "cue": ""
  },
  {
   "id": "VEN_C06_01",
   "scene": "VEN_C06",
   "speaker": "wormmaster",
   "label": "Wormmaster",
   "text": "They sent someone down at last.",
   "delivery": "spoken",
   "voice": "Wormmaster",
   "cue": ""
  },
  {
   "id": "VEN_C06_02",
   "scene": "VEN_C06",
   "speaker": "seven",
   "label": "7",
   "text": "You’re bringing their gardens down.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C06_03",
   "scene": "VEN_C06",
   "speaker": "wormmaster",
   "label": "Wormmaster",
   "text": "They can leave.",
   "delivery": "spoken",
   "voice": "Wormmaster",
   "cue": ""
  },
  {
   "id": "VEN_C06_04",
   "scene": "VEN_C06",
   "speaker": "seven",
   "label": "7",
   "text": "It’s their home.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C06_05",
   "scene": "VEN_C06",
   "speaker": "wormmaster",
   "label": "Wormmaster",
   "text": "Then they should have been more willing to negotiate.",
   "delivery": "spoken",
   "voice": "Wormmaster",
   "cue": ""
  },
  {
   "id": "VEN_C06_06",
   "scene": "VEN_C06",
   "speaker": "seven",
   "label": "7",
   "text": "Turn it off.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C06_07",
   "scene": "VEN_C06",
   "speaker": "wormmaster",
   "label": "Wormmaster",
   "text": "Come and do it yourself.",
   "delivery": "spoken",
   "voice": "Wormmaster",
   "cue": ""
  },
  {
   "id": "VEN_C07_01",
   "scene": "VEN_C07",
   "speaker": "wormmaster",
   "label": "Wormmaster",
   "text": "You don’t know what you’re interfering with.",
   "delivery": "spoken",
   "voice": "Wormmaster",
   "cue": ""
  },
  {
   "id": "VEN_C07_02",
   "scene": "VEN_C07",
   "speaker": "seven",
   "label": "7",
   "text": "I know what was standing above it.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C08_01",
   "scene": "VEN_C08",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "The ground is quiet.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C08_02",
   "scene": "VEN_C08",
   "speaker": "seven",
   "label": "7",
   "text": "It will need repairs.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C08_03",
   "scene": "VEN_C08",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "Repairs we can make.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C08_04",
   "scene": "VEN_C08",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "You came with a question.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C09_01",
   "scene": "VEN_C09",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "What did you see?",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C09_02",
   "scene": "VEN_C09",
   "speaker": "seven",
   "label": "7",
   "text": "The gardens. Before the towers were finished.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C09_03",
   "scene": "VEN_C09",
   "speaker": "seven",
   "label": "7",
   "text": "And someone gave me something.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C09_04",
   "scene": "VEN_C09",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "What?",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C09_05",
   "scene": "VEN_C09",
   "speaker": "seven",
   "label": "7",
   "text": "A seed.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C09_06",
   "scene": "VEN_C09",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "That is not part of the record I opened.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C09_07",
   "scene": "VEN_C09",
   "speaker": "seven",
   "label": "7",
   "text": "Then where did it come from?",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C09_08",
   "scene": "VEN_C09",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "I don’t know.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C10_01",
   "scene": "VEN_C10",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "Take this record with you.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C10_02",
   "scene": "VEN_C10",
   "speaker": "seven",
   "label": "7",
   "text": "You still have it here?",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C10_03",
   "scene": "VEN_C10",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "Yes.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C10_04",
   "scene": "VEN_C10",
   "speaker": "seven",
   "label": "7",
   "text": "Then why give me another?",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C10_05",
   "scene": "VEN_C10",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "You saw how close he came.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C10_06",
   "scene": "VEN_C10",
   "speaker": "guardian",
   "label": "Guardian",
   "text": "If this place were lost, I would want someone to know we had been here.",
   "delivery": "spoken",
   "voice": "Guardian",
   "cue": ""
  },
  {
   "id": "VEN_C11_01",
   "scene": "VEN_C11",
   "speaker": "cat",
   "label": "Panther",
   "text": "Did they know what it was?",
   "delivery": "telepathic",
   "voice": "Cat",
   "cue": ""
  },
  {
   "id": "VEN_C11_02",
   "scene": "VEN_C11",
   "speaker": "seven",
   "label": "7",
   "text": "The Moon’s record. Venus has its own.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C11_03",
   "scene": "VEN_C11",
   "speaker": "cat",
   "label": "Panther",
   "text": "And the people you saw?",
   "delivery": "telepathic",
   "voice": "Cat",
   "cue": ""
  },
  {
   "id": "VEN_C11_04",
   "scene": "VEN_C11",
   "speaker": "seven",
   "label": "7",
   "text": "They’re less certain about that.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C11_05",
   "scene": "VEN_C11",
   "speaker": "seven",
   "label": "7",
   "text": "There was something else. Something the guardian said wasn’t in their record.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C11_06",
   "scene": "VEN_C11",
   "speaker": "cat",
   "label": "Panther",
   "text": "What did you see?",
   "delivery": "telepathic",
   "voice": "Cat",
   "cue": ""
  },
  {
   "id": "VEN_C11_07",
   "scene": "VEN_C11",
   "speaker": "seven",
   "label": "7",
   "text": "Someone giving me a seed.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C11_08",
   "scene": "VEN_C11",
   "speaker": "seven",
   "label": "7",
   "text": "I wish I could remember their face.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C11_09",
   "scene": "VEN_C11",
   "speaker": "seven",
   "label": "7",
   "text": "There are other temples.",
   "delivery": "spoken",
   "voice": "Seven",
   "cue": ""
  },
  {
   "id": "VEN_C11_10",
   "scene": "VEN_C11",
   "speaker": "cat",
   "label": "Panther",
   "text": "Then we have somewhere else to ask.",
   "delivery": "telepathic",
   "voice": "Cat",
   "cue": ""
  }
 ]
}