   "action": "Turns from the image to her.",
   "voice": "Machinist"
  },
  {
   "id": "AST_09_09",
   "scene": "AST_09",
   "speaker": "seven",
   "label": "7",
   "text": "Keep what’s left safe. The records. The things they made.",
   "direction": "",
   "action": "Indicates the surviving archive.",
   "voice": "Seven"
