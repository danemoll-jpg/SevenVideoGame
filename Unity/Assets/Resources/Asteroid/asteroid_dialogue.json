   "scene": "AST_09",
   "speaker": "seven",
   "label": "7",
   "text": "Start there.",
   "direction": "Gentle certainty",
   "action": "Gentle certainty.",
   "voice": "Seven"
  },
  {
   "id": "AST_10_01",
   "scene": "AST_10",
   "speaker": "seven",
   "label": "7",
   "text": "Hello, you.",
   "direction": "Warm, tired voice",
   "action": "Warm, tired voice.",
   "voice": "Seven"
  },
