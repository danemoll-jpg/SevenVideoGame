   "title": "The city that still works",
   "round": 16
  },
  {
   "id": "AST_04",
   "title": "The Machinist",
   "round": 16
  },
  {
   "id": "AST_05",
   "title": "Keeping the wrong thing alive",
   "round": 16
  },
  {
   "id": "AST_06",
   "title": "A missed answer",
   "round": 16
  },
  {
   "id": "AST_07",
   "title": "The caretaker's objection",
   "round": 16
  },
  {
   "id": "AST_08",
   "title": "What the machines were for",
   "round": 16
  },
  {
   "id": "AST_09",
   "title": "A different instruction",
   "round": 16
  },
  {
   "id": "AST_10",
   "title": "Back aboard",
   "round": 16
  },
  {
   "id": "AST_11A",
   "title": "Next destination (Biaveh unfinished)",
   "round": 16
  },
  {
   "id": "AST_11B",
   "title": "Next destination (Biaveh complete: the Cattalus lead)",
   "round": 16
  }
 ],
 "lines": [
  {
   "id": "AST_01_01",
   "scene": "AST_01",
   "speaker": "seven",
   "label": "7",
   "text": "That’s built into it?",
   "direction": "",
   "action": "Leans forward; wide view through the window.",
   "voice": "Seven"
  },
  {
   "id": "AST_01_02",
   "scene": "AST_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Through it, from what I can see.",
   "direction": "",
   "action": "Ears turn toward a faint mechanical sound.",
   "voice": "Cat"
  },
  {
   "id": "AST_01_03",
   "scene": "AST_01",
   "speaker": "seven",
   "label": "7",
   "text": "Huh. Someone really wanted a workshop.",
   "direction": "Small, impressed laugh",
   "action": "Small, impressed laugh.",
   "voice": "Seven"
  },
  {
   "id": "AST_01_04",
   "scene": "AST_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Someone apparently wanted every workshop.",
   "direction": "Dry",
   "action": "Dry; looks up at her.",
   "voice": "Cat"
  },
  {
   "id": "AST_01_05",
   "scene": "AST_01",
   "speaker": "seven",
   "label": "7",
   "text": "There are lights.",
   "direction": "",
   "action": "Her hand stops stroking his back.",
   "voice": "Seven"
  },
  {
   "id": "AST_01_06",
   "scene": "AST_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Mm-hmm. Something is still working.",
   "direction": "",
   "action": "Turns toward the display.",
   "voice": "Cat"
  },
  {
   "id": "AST_01_07",
   "scene": "AST_01",
   "speaker": "seven",
   "label": "7",
   "text": "Let’s find out who.",
   "direction": "",
   "action": "Gently lifts him onto the adjoining seat.",
   "voice": "Seven"
  },
  {
   "id": "AST_01_08",
   "scene": "AST_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "I was working.",
   "direction": "",
   "action": "Glances at her now-empty lap.",
   "voice": "Cat"
  },
  {
   "id": "AST_01_09",
   "scene": "AST_01",
   "speaker": "seven",
   "label": "7",
   "text": "Oh? At what?",
   "direction": "Suppressed giggle",
   "action": "Suppressed giggle.",
   "voice": "Seven"
  },
  {
   "id": "AST_01_10",
   "scene": "AST_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Keeping you seated.",
   "direction": "",
   "action": "Unhurried stretch.",
   "voice": "Cat"
  },
  {
   "id": "AST_02_01",
   "scene": "AST_02",
   "speaker": "seven",
   "label": "7",
   "text": "Hello.",
   "direction": "",
   "action": "Small wave; waits for a response.",
   "voice": "Seven"
  },
  {
   "id": "AST_02_02",
   "scene": "AST_02",
   "speaker": "system",
   "label": "System",
   "text": "Unregistered material. Proceed to sorting.",
   "direction": "Flat recorded announcement",
   "action": "Flat recorded announcement.",
   "voice": "system"
  },
  {
   "id": "AST_02_03",
   "scene": "AST_02",
   "speaker": "seven",
   "label": "7",
   "text": "Material?",
   "direction": "",
   "action": "Looks down at herself, then back at the machine.",
   "voice": "Seven"
  },
  {
   "id": "AST_02_04",
   "scene": "AST_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "You do contain quite a lot of it.",
   "direction": "amused",
   "action": "Telepathic, amused.",
   "voice": "Cat"
  },
  {
   "id": "AST_02_05",
   "scene": "AST_02",
   "speaker": "seven",
   "label": "7",
   "text": "Thank you. Very helpful.",
   "direction": "Quiet snort of laughter",
   "action": "Quiet snort of laughter.",
   "voice": "Seven"
  },
  {
   "id": "AST_02_06",
   "scene": "AST_02",
   "speaker": "system",
   "label": "System",
   "text": "Please remain intact during transport.",
   "direction": "",
   "action": "Conveyor begins moving.",
   "voice": "system"
  },
  {
   "id": "AST_02_07",
   "scene": "AST_02",
   "speaker": "seven",
   "label": "7",
   "text": "Mm. Don’t like that bit.",
   "direction": "",
   "action": "Steps back from the belt.",
   "voice": "Seven"
  },
  {
   "id": "AST_02_08",
   "scene": "AST_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "There’s a service entrance to your left.",
   "direction": "Tone becomes practical",
   "action": "Tone becomes practical.",
   "voice": "Cat"
  },
  {
   "id": "AST_03_01",
   "scene": "AST_03",
   "speaker": "seven",
   "label": "7",
   "text": "It’s all still going.",
   "direction": "",
   "action": "Slows the bike; camera reveals the cavern beyond her shoulder.",
   "voice": "Seven"
  },
  {
   "id": "AST_03_02",
   "scene": "AST_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Yes.",
   "direction": "",
   "action": "Brief pause.",
   "voice": "Cat"
  },
  {
   "id": "AST_03_03",
   "scene": "AST_03",
   "speaker": "seven",
   "label": "7",
   "text": "But there’s nobody at the stations.",
   "direction": "",
   "action": "Looks toward the empty seats.",
   "voice": "Seven"
  },
  {
   "id": "AST_03_04",
   "scene": "AST_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "I haven’t found anyone yet.",
   "direction": "Gentle",
   "action": "Gentle, without explaining the mystery away.",
   "voice": "Cat"
  },
  {
   "id": "AST_03_05",
   "scene": "AST_03",
   "speaker": "seven",
   "label": "7",
   "text": "Look at this. Someone kept fixing it.",
   "direction": "",
   "action": "Turns the bird carefully in her hands.",
   "voice": "Seven"
  },
  {
   "id": "AST_03_06",
   "scene": "AST_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Does it still work?",
   "direction": "Curious",
   "action": "Curious.",
   "voice": "Cat"
  },
  {
   "id": "AST_03_07",
   "scene": "AST_03",
   "speaker": "seven",
   "label": "7",
   "text": "Hang on…",
   "direction": "",
   "action": "Finds a small winding control.",
   "voice": "Seven"
  },
  {
   "id": "AST_03_09",
   "scene": "AST_03",
   "speaker": "seven",
   "label": "7",
   "text": "Ha! There you are.",
   "direction": "Delighted little laugh",
   "action": "Delighted little laugh.",
   "voice": "Seven"
  },
  {
   "id": "AST_03_10",
   "scene": "AST_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Hm. Very convincing.",
   "direction": "",
   "action": "A beat too interested.",
   "voice": "Cat"
  },
  {
   "id": "AST_03_11",
   "scene": "AST_03",
   "speaker": "seven",
   "label": "7",
   "text": "You’re doing that voice.",
   "direction": "",
   "action": "Glances toward her communicator, smiling.",
   "voice": "Seven"
  },
  {
   "id": "AST_03_12",
   "scene": "AST_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "What voice?",
   "direction": "Innocent",
   "action": "Innocent.",
   "voice": "Cat"
  },
  {
   "id": "AST_03_13",
   "scene": "AST_03",
   "speaker": "seven",
   "label": "7",
   "text": "The one you do when something small moves.",
   "direction": "Quiet giggle",
   "action": "Quiet giggle; places the bird safely back.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_01",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "You have left the receiving route.",
   "direction": "",
   "action": "Stops precisely in front of her.",
   "voice": "Machinist"
  },
  {
   "id": "AST_04_02",
   "scene": "AST_04",
   "speaker": "seven",
   "label": "7",
   "text": "Yes. It was taking me somewhere unpleasant.",
   "direction": "restrained humour",
   "action": "Glances back; restrained humour.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_03",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "Sorting.",
   "direction": "",
   "action": "A small adjustment of his head.",
   "voice": "Machinist"
  },
  {
   "id": "AST_04_04",
   "scene": "AST_04",
   "speaker": "seven",
   "label": "7",
   "text": "Mm-hmm. That was the unpleasant part.",
   "direction": "",
   "action": "Holds her ground.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_05",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "State your function.",
   "direction": "",
   "action": "Scans her.",
   "voice": "Machinist"
  },
  {
   "id": "AST_04_06",
   "scene": "AST_04",
   "speaker": "seven",
   "label": "7",
   "text": "I’m looking for your temple.",
   "direction": "",
   "action": "Open hands; straightforward.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_07",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "Archive access is suspended.",
   "direction": "",
   "action": "Turns toward an active assembly.",
   "voice": "Machinist"
  },
  {
   "id": "AST_04_08",
   "scene": "AST_04",
   "speaker": "seven",
   "label": "7",
   "text": "Until when?",
   "direction": "",
   "action": "Takes one step after him.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_09",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "Until restoration is complete.",
   "direction": "",
   "action": "Continues working.",
   "voice": "Machinist"
  },
  {
   "id": "AST_04_10",
   "scene": "AST_04",
   "speaker": "seven",
   "label": "7",
   "text": "And… how long has that been?",
   "direction": "Her humour fades",
   "action": "Her humour fades.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_11",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "Restoration is ongoing.",
   "direction": "",
   "action": "Brief mechanical hesitation before the answer.",
   "voice": "Machinist"
  },
  {
   "id": "AST_04_12",
   "scene": "AST_04",
   "speaker": "seven",
   "label": "7",
   "text": "Wait. That came from the archive.",
   "direction": "",
   "action": "Points to the panel.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_13",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "Unused material is being reassigned.",
   "direction": "",
   "action": "No malice; certainty.",
   "voice": "Machinist"
  },
  {
   "id": "AST_04_14",
   "scene": "AST_04",
   "speaker": "seven",
   "label": "7",
   "text": "There’s writing on it.",
   "direction": "",
   "action": "Moves toward the mechanism.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_15",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "There are no outstanding requests to read it.",
   "direction": "",
   "action": "Blocks her path.",
   "voice": "Machinist"
  },
  {
   "id": "AST_04_16",
   "scene": "AST_04",
   "speaker": "seven",
   "label": "7",
   "text": "I’m requesting it.",
   "direction": "Quiet and firm",
   "action": "Quiet and firm.",
   "voice": "Seven"
  },
  {
   "id": "AST_04_17",
   "scene": "AST_04",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "Request denied.",
   "direction": "",
   "action": "Security shutters begin closing.",
   "voice": "Machinist"
  },
  {
   "id": "AST_05_01",
   "scene": "AST_05",
   "speaker": "seven",
   "label": "7",
   "text": "He’s taking the place apart to keep it running.",
   "direction": "Low voice",
   "action": "Low voice.",
   "voice": "Seven"
  },
  {
   "id": "AST_05_02",
   "scene": "AST_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "The archive feed goes directly to the foundry.",
   "direction": "",
   "action": "Studying the system aboard the saucer.",
   "voice": "Cat"
  },
  {
   "id": "AST_05_03",
   "scene": "AST_05",
   "speaker": "seven",
   "label": "7",
   "text": "Can we stop it?",
   "direction": "",
   "action": "Turns toward the control terminal.",
   "voice": "Seven"
  },
  {
   "id": "AST_05_04",
   "scene": "AST_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "The whole foundry? Not safely. It also powers the stabilizers.",
   "direction": "Measured",
   "action": "Measured.",
   "voice": "Cat"
  },
  {
   "id": "AST_05_05",
   "scene": "AST_05",
   "speaker": "seven",
   "label": "7",
   "text": "All right. Just the archive line.",
   "direction": "",
   "action": "Searches the terminal.",
   "voice": "Seven"
  },
  {
   "id": "AST_05_06",
   "scene": "AST_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "There’s a maintenance bypass. Three local controls.",
   "direction": "",
   "action": "A route appears on her display.",
   "voice": "Cat"
  },
  {
   "id": "AST_05_07",
   "scene": "AST_05",
   "speaker": "seven",
   "label": "7",
   "text": "Of course there are.",
   "direction": "Sigh, followed by a small laugh",
   "action": "Sigh, followed by a small laugh.",
   "voice": "Seven"
  },
  {
   "id": "AST_05_08",
   "scene": "AST_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "Would you prefer four?",
   "direction": "Dry",
   "action": "Dry.",
   "voice": "Cat"
  },
  {
   "id": "AST_05_09",
   "scene": "AST_05",
   "speaker": "seven",
   "label": "7",
   "text": "Don’t encourage it.",
   "direction": "",
   "action": "Pushes away from the terminal.",
   "voice": "Seven"
  },
  {
   "id": "AST_06_01",
   "scene": "AST_06",
   "speaker": "seven",
   "label": "7",
   "text": "Oh—!",
   "direction": "",
   "action": "Sharp intake of breath as the platform moves.",
   "voice": "Seven"
  },
  {
   "id": "AST_06_02",
   "scene": "AST_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Seven?",
   "direction": "",
   "action": "Immediate; no joke.",
   "voice": "Cat"
  },
  {
   "id": "AST_06_04",
   "scene": "AST_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Seven. Answer me.",
   "direction": "More controlled, more frightened",
   "action": "More controlled, more frightened.",
   "voice": "Cat"
  },
  {
   "id": "AST_06_05",
   "scene": "AST_06",
   "speaker": "seven",
   "label": "7",
   "text": "Here. I’m here.",
   "direction": "Breathless",
   "action": "Breathless, hauling herself onto the ledge.",
   "voice": "Seven"
  },
  {
   "id": "AST_06_06",
   "scene": "AST_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Are you hurt?",
   "direction": "Tight voice",
   "action": "Tight voice.",
   "voice": "Cat"
  },
  {
   "id": "AST_06_07",
   "scene": "AST_06",
   "speaker": "seven",
   "label": "7",
   "text": "Just… give me a second.",
   "direction": "steadies her breathing",
   "action": "Sits back briefly; steadies her breathing.",
   "voice": "Seven"
  },
  {
   "id": "AST_06_08",
   "scene": "AST_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Take it.",
   "direction": "Quiet",
   "action": "Quiet.",
   "voice": "Cat"
  },
  {
   "id": "AST_06_09",
   "scene": "AST_06",
   "speaker": "seven",
   "label": "7",
   "text": "I’m all right.",
   "direction": "Softer",
   "action": "Softer, once she has checked herself.",
   "voice": "Seven"
  },
  {
   "id": "AST_06_10",
   "scene": "AST_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Good.",
   "direction": "Audible exhale",
   "action": "Audible exhale.",
   "voice": "Cat"
  },
  {
   "id": "AST_06_11",
   "scene": "AST_06",
   "speaker": "seven",
   "label": "7",
   "text": "You went very quiet.",
   "direction": "",
   "action": "Looks toward the distant saucer marker.",
   "voice": "Seven"
  },
  {
   "id": "AST_06_12",
   "scene": "AST_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "So did you.",
   "direction": "",
   "action": "A beat of silence afterward.",
   "voice": "Cat"
  },
  {
   "id": "AST_06_13",
   "scene": "AST_06",
   "speaker": "seven",
   "label": "7",
   "text": "I’ll keep talking.",
   "direction": "",
   "action": "Small, reassuring smile in her voice.",
   "voice": "Seven"
  },
  {
   "id": "AST_06_14",
   "scene": "AST_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "An unusual thing for me to request, but… yes.",
   "direction": "Dryness returning gently",
   "action": "Dryness returning gently.",
   "voice": "Cat"
  },
  {
   "id": "AST_06_15",
   "scene": "AST_06",
   "speaker": "seven",
   "label": "7",
   "text": "Heh. There you are.",
   "direction": "Quiet chuckle",
   "action": "Quiet chuckle; gets to her feet.",
   "voice": "Seven"
  },
  {
   "id": "AST_07_01",
   "scene": "AST_07",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "You are interfering with restoration.",
   "direction": "",
   "action": "Heavy steps toward the controls.",
   "voice": "Machinist"
  },
  {
   "id": "AST_07_02",
   "scene": "AST_07",
   "speaker": "seven",
   "label": "7",
   "text": "I’m saving the archive.",
   "direction": "",
   "action": "Stands between him and the terminal.",
   "voice": "Seven"
  },
  {
   "id": "AST_07_03",
   "scene": "AST_07",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "That material is required.",
   "direction": "",
   "action": "Reaches past her toward the override.",
   "voice": "Machinist"
  },
  {
   "id": "AST_07_04",
   "scene": "AST_07",
   "speaker": "seven",
   "label": "7",
   "text": "For what? There’s no one here using any of this.",
   "direction": "",
   "action": "Frustration, not cruelty.",
   "voice": "Seven"
  },
  {
   "id": "AST_07_05",
   "scene": "AST_07",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "It must be ready when they return.",
   "direction": "",
   "action": "His hand stops over the control.",
   "voice": "Machinist"
  },
  {
   "id": "AST_07_07",
   "scene": "AST_07",
   "speaker": "seven",
   "label": "7",
   "text": "You’re waiting for them.",
   "direction": "Quiet",
   "action": "Quiet.",
   "voice": "Seven"
  },
  {
   "id": "AST_07_08",
   "scene": "AST_07",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "Stand aside.",
   "direction": "",
   "action": "Resumes the override.",
   "voice": "Machinist"
  },
  {
   "id": "AST_07_09",
   "scene": "AST_07",
   "speaker": "seven",
   "label": "7",
   "text": "I can’t let you destroy what they left.",
   "direction": "",
   "action": "Plants her feet.",
   "voice": "Seven"
  },
  {
   "id": "AST_07_10",
   "scene": "AST_07",
   "speaker": "cat",
   "label": "Panther",
