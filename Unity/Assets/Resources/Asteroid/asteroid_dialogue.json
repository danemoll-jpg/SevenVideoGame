  {
   "id": "AST_09_07",
   "scene": "AST_09",
   "speaker": "seven",
   "label": "7",
   "text": "They were allowed to. It belonged to them.",
   "direction": "Calm",
   "action": "Calm; no lecture.",
   "voice": "Seven"
  },
  {
   "id": "AST_09_08",
   "scene": "AST_09",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "What is required of me?",
