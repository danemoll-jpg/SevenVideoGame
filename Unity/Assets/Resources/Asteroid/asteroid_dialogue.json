   "scene": "AST_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "What line?",
   "direction": "Patient",
   "action": "Patient.",
   "voice": "Cat"
  },
  {
   "id": "AST_08_04",
   "scene": "AST_08",
   "speaker": "seven",
   "label": "7",
   "text": "All of this. Just to mend a little bird.",
   "direction": "A small, disbelieving laugh",
   "action": "A small, disbelieving laugh.",
   "voice": "Seven"
  },
  {
   "id": "AST_08_05",
   "scene": "AST_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "The one you found?",
   "direction": "Curious",
   "action": "Curious.",
   "voice": "Cat"
  },
  {
   "id": "AST_08_06",
   "scene": "AST_08",
   "speaker": "seven",
   "label": "7",
   "text": "I think so.",
   "direction": "",
   "action": "Looks back toward the workshop passage.",
   "voice": "Seven"
  },
  {
   "id": "AST_08_07",
   "scene": "AST_08",
   "speaker": "seven",
   "label": "7",
   "text": "I knew what it would sound like. Before it moved.",
   "direction": "Quiet wonder",
   "action": "Quiet wonder; hold the shot.",
   "voice": "Seven"
  },
  {
   "id": "AST_09_01",
   "scene": "AST_09",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "That assembly was discontinued.",
   "direction": "",
   "action": "Watches the image.",
   "voice": "Machinist"
  },
  {
   "id": "AST_09_02",
   "scene": "AST_09",
   "speaker": "seven",
   "label": "7",
   "text": "Someone kept repairing it.",
   "direction": "Softly",
   "action": "Softly.",
   "voice": "Seven"
  },
  {
   "id": "AST_09_03",
   "scene": "AST_09",
   "speaker": "machinist",
   "label": "Machinist",
   "text": "Replacement would have been more efficient.",
   "direction": "",
   "action": "Small head adjustment.",
   "voice": "Machinist"
  },
  {
   "id": "AST_09_04",
   "scene": "AST_09",
   "speaker": "seven",
   "label": "7",
   "text": "Mm. But they wanted that one.",
   "direction": "",
   "action": "Lets the memory continue.",
   "voice": "Seven"
  },
  {
