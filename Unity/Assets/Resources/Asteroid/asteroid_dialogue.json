   "id": "AST_10_03",
   "scene": "AST_10",
   "speaker": "seven",
   "label": "7",
   "text": "We didn’t agree on a time.",
   "direction": "Small laugh",
   "action": "Small laugh.",
   "voice": "Seven"
  },
  {
   "id": "AST_10_04",
   "scene": "AST_10",
   "speaker": "cat",
   "label": "Panther",
   "text": "I decided on one. You missed it.",
   "direction": "",
   "action": "His tail curls around her wrist.",
   "voice": "Cat"
  },
  {
   "id": "AST_10_05",
   "scene": "AST_10",
   "speaker": "seven",
   "label": "7",
   "text": "Mm. Sorry.",
   "direction": "",
   "action": "Rubs behind his ear.",
   "voice": "Seven"
  },
  {
   "id": "AST_10_07",
   "scene": "AST_10",
   "speaker": "seven",
   "label": "7",
   "text": "He kept everything ready. All that time.",
   "direction": "",
   "action": "Watches the asteroid through the window.",
   "voice": "Seven"
