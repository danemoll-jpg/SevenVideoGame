   "voice": "Seven"
  },
  {
   "id": "BIA_11_11",
   "scene": "BIA_11",
   "speaker": "nela",
   "label": "Nela",
   "text": "Would you like to share what you saw?",
   "direction": "Unpressured",
   "action": "Unpressured.",
   "voice": "nela"
  },
  {
   "id": "BIA_11_12",
   "scene": "BIA_11",
   "speaker": "seven",
   "label": "7",
   "text": "Not yet.",
   "direction": "",
   "action": "Looks up.",
