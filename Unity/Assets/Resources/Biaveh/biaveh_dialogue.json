 ],
 "lines": [
  {
   "id": "BIA_01_01",
   "scene": "BIA_01",
   "speaker": "seven",
   "label": "7",
   "text": "Is that Biaveh?",
   "direction": "",
   "action": "Looks toward the planet.",
   "voice": "Seven"
  },
  {
   "id": "BIA_01_02",
   "scene": "BIA_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Veyra. The route leads to a Biavian station here.",
   "direction": "",
   "action": "Checks the navigation display.",
   "voice": "Cat"
  },
  {
   "id": "BIA_01_03",
   "scene": "BIA_01",
   "speaker": "seven",
   "label": "7",
   "text": "That’s the station?",
   "direction": "",
   "action": "The egg-shaped vessel comes fully into view.",
   "voice": "Seven"
  },
  {
   "id": "BIA_01_04",
   "scene": "BIA_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Their mothership. Twenty-six miles across.",
   "direction": "",
   "action": "Looks up from the display.",
   "voice": "Cat"
  },
  {
   "id": "BIA_01_05",
   "scene": "BIA_01",
   "speaker": "seven",
   "label": "7",
   "text": "Across?",
   "direction": "Quiet, astonished laugh",
   "action": "Quiet, astonished laugh.",
   "voice": "Seven"
  },
  {
   "id": "BIA_01_06",
   "scene": "BIA_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Mm-hmm.",
   "direction": "",
   "action": "Watches the approaching silhouette.",
   "voice": "Cat"
  },
  {
   "id": "BIA_01_06a",
   "scene": "BIA_01",
   "speaker": "seven",
   "label": "7",
   "text": "I thought their mothership was in the rings of Saturn.",
   "direction": "",
   "action": "Studies it; puzzled. *(Dan, 2026-11-21)*",
   "voice": "Seven"
  },
  {
   "id": "BIA_01_06b",
   "scene": "BIA_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "That one is. This is a sister ship.",
   "direction": "Matter-of-fact",
   "action": "Matter-of-fact.",
   "voice": "Cat"
  },
  {
   "id": "BIA_01_06c",
   "scene": "BIA_01",
   "speaker": "seven",
   "label": "7",
   "text": "A sister ship. So… the aunt ship?",
   "direction": "",
   "action": "Deadpan, looking down at him.",
   "voice": "Seven"
  },
  {
   "id": "BIA_01_06d",
   "scene": "BIA_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "That was a terrible joke.",
   "direction": "A reluctant chuckle first",
   "action": "A reluctant chuckle first.",
   "voice": "Cat"
  },
  {
   "id": "BIA_01_07",
   "scene": "BIA_01",
   "speaker": "seven",
   "label": "7",
   "text": "And those three things moving around it?",
   "direction": "",
   "action": "Indicates the orbs.",
   "voice": "Seven"
  },
  {
   "id": "BIA_01_08",
   "scene": "BIA_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Let’s wait to be invited before we find out.",
   "direction": "",
   "action": "Sits a little straighter.",
   "voice": "Cat"
  },
  {
   "id": "BIA_02_01",
   "scene": "BIA_02",
   "speaker": "nela",
   "label": "Nela",
   "text": "Welcome to Veyra. I am Nela. Please hold your course. Our guardians will let you through.",
   "direction": "Calm",
   "action": "Calm, telepathic.",
   "voice": "nela"
  },
  {
   "id": "BIA_02_02",
   "scene": "BIA_02",
   "speaker": "seven",
   "label": "7",
   "text": "Oh—hello.",
   "direction": "",
   "action": "Straightens, briefly looking around.",
   "voice": "Seven"
  },
  {
   "id": "BIA_02_03",
   "scene": "BIA_02",
   "speaker": "nela",
   "label": "Nela",
   "text": "Forgive me. Was that too sudden?",
   "direction": "Gentle concern",
   "action": "Gentle concern.",
   "voice": "nela"
  },
  {
   "id": "BIA_02_04",
   "scene": "BIA_02",
   "speaker": "seven",
   "label": "7",
   "text": "A little. Usually there’s a cat attached to that voice.",
   "direction": "",
   "action": "Glances down at Panther.",
   "voice": "Seven"
  },
  {
   "id": "BIA_02_05",
   "scene": "BIA_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "A considerable improvement, generally.",
   "direction": "Composure returning",
   "action": "Composure returning.",
   "voice": "Cat"
  },
  {
   "id": "BIA_02_06",
   "scene": "BIA_02",
   "speaker": "seven",
   "label": "7",
   "text": "That’s the door?",
   "direction": "",
   "action": "Leans forward.",
   "voice": "Seven"
  },
  {
   "id": "BIA_02_07",
   "scene": "BIA_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "Apparently.",
   "direction": "",
   "action": "Watches the aperture widen.",
   "voice": "Cat"
  },
  {
   "id": "BIA_02_08",
   "scene": "BIA_02",
   "speaker": "seven",
   "label": "7",
   "text": "All that ship, and they couldn’t spare a bigger entrance.",
   "direction": "Nervous little chuckle",
   "action": "Nervous little chuckle.",
   "voice": "Seven"
  },
  {
   "id": "BIA_02_09",
   "scene": "BIA_02",
   "speaker": "nela",
   "label": "Nela",
   "text": "You have sufficient clearance. Come forward slowly.",
   "direction": "Reassuring",
   "action": "Reassuring.",
   "voice": "nela"
  },
  {
   "id": "BIA_02_10",
   "scene": "BIA_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "Slowly sounds excellent.",
   "direction": "",
   "action": "Glances toward the narrowing margins.",
   "voice": "Cat"
  },
  {
   "id": "BIA_02_11",
   "scene": "BIA_02",
   "speaker": "seven",
   "label": "7",
   "text": "There. Plenty of room.",
   "direction": "Releases a breath",
   "action": "Releases a breath.",
   "voice": "Seven"
  },
  {
   "id": "BIA_02_12",
   "scene": "BIA_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "Then you can stop holding yours.",
   "direction": "Dry",
   "action": "Dry.",
   "voice": "Cat"
  },
  {
   "id": "BIA_02_13",
   "scene": "BIA_02",
   "speaker": "seven",
   "label": "7",
   "text": "Heh. You noticed.",
   "direction": "",
   "action": "Shoulders relax.",
   "voice": "Seven"
  },
  {
   "id": "BIA_02_14",
   "scene": "BIA_02",
   "speaker": "nela",
   "label": "Nela",
   "text": "Follow the lights to the receiving berth. Please remain within the marked route. We have an intruder in the inner districts.",
   "direction": "Tone becomes serious",
   "action": "Tone becomes serious.",
   "voice": "nela"
  },
  {
   "id": "BIA_03_01",
   "scene": "BIA_03",
   "speaker": "seven",
   "label": "7",
   "text": "People live all the way up there?",
   "direction": "",
   "action": "Camera follows her upward gaze.",
   "voice": "Seven"
  },
  {
   "id": "BIA_03_02",
   "scene": "BIA_03",
   "speaker": "nela",
   "label": "Nela",
   "text": "Yes. Most of us never visit every district.",
   "direction": "",
   "action": "Looks upward with her.",
   "voice": "nela"
  },
  {
   "id": "BIA_03_03",
   "scene": "BIA_03",
   "speaker": "seven",
   "label": "7",
   "text": "I can believe that.",
   "direction": "Breathes out a little laugh",
   "action": "Breathes out a little laugh.",
   "voice": "Seven"
  },
  {
   "id": "BIA_03_04",
   "scene": "BIA_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Remember where we parked.",
   "direction": "",
   "action": "Private telepathic channel.",
   "voice": "Cat"
  },
  {
   "id": "BIA_03_05",
   "scene": "BIA_03",
   "speaker": "seven",
   "label": "7",
   "text": "Little saucer. Enormous wall. Got it.",
   "direction": "Quietly amused",
   "action": "Quietly amused.",
   "voice": "Seven"
  },
  {
   "id": "BIA_03_06",
   "scene": "BIA_03",
   "speaker": "seven",
   "label": "7",
   "text": "What was that?",
   "direction": "",
   "action": "Watches the empty passage.",
   "voice": "Seven"
  },
  {
   "id": "BIA_03_07",
   "scene": "BIA_03",
   "speaker": "nela",
   "label": "Nela",
   "text": "A memory from the archive. The damaged relays are carrying it into our shared connection.",
   "direction": "",
   "action": "Stays beside the resident.",
   "voice": "nela"
  },
  {
   "id": "BIA_03_08",
   "scene": "BIA_03",
   "speaker": "seven",
   "label": "7",
   "text": "The intruder did this?",
   "direction": "",
   "action": "Kneels nearby.",
   "voice": "Seven"
  },
  {
   "id": "BIA_03_09",
   "scene": "BIA_03",
   "speaker": "nela",
   "label": "Nela",
   "text": "Yes. Ratwing. He cuts one district off, then moves through it before we can warn the next.",
   "direction": "",
   "action": "Looks toward a sealed gate.",
   "voice": "nela"
  },
  {
   "id": "BIA_03_10",
   "scene": "BIA_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Ratwing?",
   "direction": "Suddenly attentive",
   "action": "Suddenly attentive.",
   "voice": "Cat"
  },
  {
   "id": "BIA_03_11",
   "scene": "BIA_03",
   "speaker": "seven",
   "label": "7",
   "text": "You heard that part, then.",
   "direction": "A small sideways smile in her voice",
   "action": "A small sideways smile in her voice.",
   "voice": "Seven"
  },
  {
   "id": "BIA_03_12",
   "scene": "BIA_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "I’m listening to all of it.",
   "direction": "Very composed",
   "action": "Very composed.",
   "voice": "Cat"
  },
  {
   "id": "BIA_04_01",
   "scene": "BIA_04",
   "speaker": "nela",
   "label": "Nela",
   "text": "He wants the archive. Our histories, discoveries, everything entrusted to it.",
   "direction": "",
   "action": "Indicates the temple.",
   "voice": "nela"
  },
  {
   "id": "BIA_04_02",
   "scene": "BIA_04",
   "speaker": "seven",
   "label": "7",
   "text": "To sell?",
   "direction": "",
   "action": "Looks up from the display.",
   "voice": "Seven"
  },
  {
   "id": "BIA_04_03",
   "scene": "BIA_04",
   "speaker": "nela",
   "label": "Nela",
   "text": "Or to make us pay for access to our own knowledge.",
   "direction": "Quiet anger",
   "action": "Quiet anger.",
   "voice": "nela"
  },
  {
   "id": "BIA_04_04",
   "scene": "BIA_04",
   "speaker": "seven",
   "label": "7",
   "text": "And if we reconnect the districts?",
   "direction": "",
   "action": "Studies the three relays.",
   "voice": "Seven"
  },
  {
   "id": "BIA_04_05",
   "scene": "BIA_04",
   "speaker": "nela",
   "label": "Nela",
   "text": "We can coordinate our barriers and keep him from moving freely.",
   "direction": "",
   "action": "Three routes illuminate.",
   "voice": "nela"
  },
  {
   "id": "BIA_04_06",
   "scene": "BIA_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "That sounds promising.",
   "direction": "Almost too pleased",
   "action": "Almost too pleased.",
   "voice": "Cat"
  },
  {
   "id": "BIA_04_07",
   "scene": "BIA_04",
   "speaker": "seven",
   "label": "7",
   "text": "You’re enjoying this already.",
   "direction": "Under her breath, amused",
   "action": "Under her breath; amused.",
   "voice": "Seven"
  },
  {
   "id": "BIA_04_08",
   "scene": "BIA_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "I appreciate a well-defined problem.",
   "direction": "",
   "action": "A faint tail-tip twitch aboard the saucer.",
   "voice": "Cat"
  },
  {
   "id": "BIA_04_09",
   "scene": "BIA_04",
   "speaker": "nela",
   "label": "Nela",
   "text": "May I share the way with you?",
   "direction": "",
   "action": "Open hand; does not touch her.",
   "voice": "nela"
  },
  {
   "id": "BIA_04_10",
   "scene": "BIA_04",
   "speaker": "seven",
   "label": "7",
   "text": "Would you see my thoughts?",
   "direction": "Slight hesitation",
   "action": "Slight hesitation.",
   "voice": "Seven"
  },
  {
   "id": "BIA_04_11",
   "scene": "BIA_04",
   "speaker": "nela",
   "label": "Nela",
   "text": "Only what you choose to share. This can go one way.",
   "direction": "Patient reassurance",
   "action": "Patient reassurance.",
   "voice": "nela"
  },
  {
   "id": "BIA_04_12",
   "scene": "BIA_04",
   "speaker": "seven",
   "label": "7",
   "text": "All right. Just the route.",
   "direction": "",
   "action": "Her shoulders relax.",
   "voice": "Seven"
  },
  {
   "id": "BIA_04_N1",
   "scene": "BIA_04",
   "speaker": "nela",
   "label": "Nela",
   "text": "I've linked your ship to our inner sensors. Your companion will be able to follow him.",
   "direction": "Calm",
   "action": "Calm; after the route lights up. *(QF23, Dan's proposed line)*",
   "voice": "nela"
  },
  {
   "id": "BIA_04_N2",
   "scene": "BIA_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "Delighted.",
   "direction": "Far too pleased",
   "action": "Far too pleased. *(QF23, Dan's proposed line)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_05_01",
   "scene": "BIA_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "There. Above you.",
   "direction": "Immediate focus",
   "action": "Immediate focus.",
   "voice": "Cat"
  },
  {
   "id": "BIA_05_02",
   "scene": "BIA_05",
   "speaker": "seven",
   "label": "7",
   "text": "I see him.",
   "direction": "",
   "action": "Stops the bike behind a structural pillar.",
   "voice": "Seven"
  },
  {
   "id": "BIA_05_03",
   "scene": "BIA_05",
   "speaker": "ratwing",
   "label": "Ratwing",
   "text": "They’ve found someone to run their errands.",
   "direction": "",
   "action": "Looks down at the bike and damaged cabinet.",
   "voice": "Ratwing"
  },
  {
   "id": "BIA_05_04",
   "scene": "BIA_05",
   "speaker": "seven",
   "label": "7",
   "text": "You’ve made quite a mess.",
   "direction": "",
   "action": "Steps off the bike.",
   "voice": "Seven"
  },
  {
   "id": "BIA_05_05",
   "scene": "BIA_05",
   "speaker": "ratwing",
   "label": "Ratwing",
   "text": "They can tidy up when we’ve agreed on a price.",
   "direction": "",
   "action": "Casual, possessive gesture toward the city.",
   "voice": "Ratwing"
  },
  {
   "id": "BIA_05_06",
   "scene": "BIA_05",
   "speaker": "seven",
   "label": "7",
   "text": "For their own archive?",
   "direction": "Disbelief",
   "action": "Disbelief.",
   "voice": "Seven"
  },
  {
   "id": "BIA_05_07",
   "scene": "BIA_05",
   "speaker": "ratwing",
   "label": "Ratwing",
   "text": "They seem very attached to it.",
   "direction": "Thin amusement",
   "action": "Thin amusement.",
   "voice": "Ratwing"
  },
  {
   "id": "BIA_05_08",
   "scene": "BIA_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "Follow him.",
   "direction": "",
   "action": "Leans toward the saucer display.",
   "voice": "Cat"
  },
  {
   "id": "BIA_05_09",
   "scene": "BIA_05",
   "speaker": "seven",
   "label": "7",
   "text": "Panther.",
   "direction": "",
   "action": "Looks at the damaged relay.",
   "voice": "Seven"
  },
  {
   "id": "BIA_05_10",
   "scene": "BIA_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "We should establish where he’s going.",
   "direction": "",
   "action": "Quick correction.",
   "voice": "Cat"
  },
  {
   "id": "BIA_05_11",
   "scene": "BIA_05",
   "speaker": "seven",
   "label": "7",
   "text": "Mm-hmm. Is your tail doing that little twitch?",
   "direction": "Suppressed giggle",
   "action": "Suppressed giggle.",
   "voice": "Seven"
  },
  {
   "id": "BIA_05_13",
   "scene": "BIA_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "Repair the relay.",
   "direction": "Dignified",
   "action": "Dignified.",
   "voice": "Cat"
  },
  {
   "id": "BIA_05_14",
   "scene": "BIA_05",
   "speaker": "seven",
   "label": "7",
   "text": "Thought so.",
   "direction": "Quiet laugh",
   "action": "Quiet laugh; approaches the controls.",
   "voice": "Seven"
  },
  {
   "id": "BIA_05_N1",
   "scene": "BIA_05",
   "speaker": "nela",
   "label": "Nela",
   "text": "The relay is in that cabinet at the junction. He tore its coupling loose. Seat it again and this district will hear us.",
   "direction": "Calm, precise",
   "action": "Calm, precise. *(QF23, new - Dan to review)*",
   "voice": "nela"
  },
  {
   "id": "BIA_06_N1",
   "scene": "BIA_06",
   "speaker": "nela",
   "label": "Nela",
   "text": "That relay also held our bridge in line. Without it the span drifted apart, and our people are stranded on the far side.",
   "direction": "Concerned",
   "action": "Concerned. *(QF23, new - Dan to review)*",
   "voice": "nela"
  },
  {
   "id": "BIA_06_N2",
   "scene": "BIA_06",
   "speaker": "nela",
   "label": "Nela",
   "text": "The bridge's service controls are at the chasm's edge. Bring the segments back together.",
   "direction": "Precise",
   "action": "Precise. *(QF23, new - Dan to review)*",
   "voice": "nela"
  },
  {
   "id": "BIA_06_01",
   "scene": "BIA_06",
   "speaker": "resident1",
   "label": "Resident",
   "text": "Thank you. We thought we might be here all day.",
   "direction": "",
   "action": "Adjusts the container.",
   "voice": "resident1"
  },
  {
   "id": "BIA_06_02",
   "scene": "BIA_06",
   "speaker": "seven",
   "label": "7",
   "text": "Are those all yours?",
   "direction": "",
   "action": "Looks at the crowded seedlings.",
   "voice": "Seven"
  },
  {
   "id": "BIA_06_03",
   "scene": "BIA_06",
   "speaker": "resident1",
   "label": "Resident",
   "text": "They were smaller when I left home.",
   "direction": "Weary amusement",
   "action": "Weary amusement.",
   "voice": "resident1"
  },
  {
   "id": "BIA_06_04",
   "scene": "BIA_06",
   "speaker": "seven",
   "label": "7",
   "text": "Heh. Good luck.",
   "direction": "",
   "action": "Steps aside.",
   "voice": "Seven"
  },
  {
   "id": "BIA_06_05",
   "scene": "BIA_06",
   "speaker": "nela",
   "label": "Nela",
   "text": "We have the crossing. Everyone is through.",
   "direction": "Relief",
   "action": "Relief.",
   "voice": "nela"
  },
  {
   "id": "BIA_06_06",
   "scene": "BIA_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "And he’s lost that passage.",
   "direction": "",
   "action": "Watching Ratwing’s movement marker.",
   "voice": "Cat"
  },
  {
   "id": "BIA_06_07",
   "scene": "BIA_06",
   "speaker": "seven",
   "label": "7",
   "text": "Still watching him?",
   "direction": "",
   "action": "Mounts the bike.",
   "voice": "Seven"
  },
  {
   "id": "BIA_06_08",
   "scene": "BIA_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Someone should.",
   "direction": "Entirely serious",
   "action": "Entirely serious.",
   "voice": "Cat"
  },
  {
   "id": "BIA_07_N1",
   "scene": "BIA_07",
   "speaker": "nela",
   "label": "Nela",
   "text": "Careful. This garden is remembering itself. The damaged relay is leaking an old memory of it into the present. Some of what you see isn't really there.",
   "direction": "Calm warning",
   "action": "Calm warning. *(QF23, Dan's proposed line)*",
   "voice": "nela"
  },
  {
   "id": "BIA_07_N2",
   "scene": "BIA_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "The old layout and the new one don't agree. Look for what's real.",
   "direction": "Dry",
   "action": "Dry. *(QF23, Dan's proposed line)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_07_N3",
   "scene": "BIA_07",
   "speaker": "nela",
   "label": "Nela",
   "text": "The second relay is behind the garden wall. Its old door was sealed when the garden was rebuilt.",
   "direction": "Precise",
   "action": "Precise. *(QF23, new - Dan to review)*",
   "voice": "nela"
  },
  {
   "id": "BIA_07_01",
   "scene": "BIA_07",
   "speaker": "seven",
   "label": "7",
   "text": "There used to be a door here.",
   "direction": "",
   "action": "Studies the wall.",
   "voice": "Seven"
  },
  {
   "id": "BIA_07_02",
   "scene": "BIA_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "There’s a seam. Lower down.",
   "direction": "Focused",
   "action": "Focused.",
   "voice": "Cat"
  },
  {
   "id": "BIA_07_03",
   "scene": "BIA_07",
   "speaker": "seven",
   "label": "7",
   "text": "Mm. Found it.",
   "direction": "",
   "action": "Kneels beside the release.",
   "voice": "Seven"
  },
  {
   "id": "BIA_07_04",
   "scene": "BIA_07",
   "speaker": "ratwing",
   "label": "Ratwing",
   "text": "Leave it alone.",
   "direction": "",
   "action": "A sharp strike against the partition.",
   "voice": "Ratwing"
  },
  {
   "id": "BIA_07_05",
   "scene": "BIA_07",
   "speaker": "seven",
   "label": "7",
   "text": "You first.",
   "direction": "",
   "action": "Keeps working; glances toward him.",
   "voice": "Seven"
  },
  {
   "id": "BIA_07_N4",
   "scene": "BIA_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "There's a service opening above the glass. He can get round through it. The control's beside you.",
   "direction": "Quick, low",
   "action": "Quick, low. *(QF23, Dan's proposed line)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_07_06",
   "scene": "BIA_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "He’s looking at the upper opening.",
   "direction": "Quiet observation",
   "action": "Quiet observation.",
   "voice": "Cat"
  },
  {
   "id": "BIA_07_07",
   "scene": "BIA_07",
   "speaker": "seven",
   "label": "7",
   "text": "Can he get through?",
   "direction": "",
   "action": "Hand poised over the controls.",
   "voice": "Seven"
  },
  {
   "id": "BIA_07_08",
   "scene": "BIA_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "Yes. Close it now.",
   "direction": "Precise",
   "action": "Precise.",
   "voice": "Cat"
  },
  {
   "id": "BIA_07_09",
   "scene": "BIA_07",
   "speaker": "seven",
   "label": "7",
   "text": "How did you know?",
   "direction": "",
   "action": "Watches him disappear.",
   "voice": "Seven"
  },
  {
   "id": "BIA_07_10",
   "scene": "BIA_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "He looked at the gap. Then he gathered his feet under him.",
   "direction": "Matter-of-fact",
   "action": "Matter-of-fact.",
   "voice": "Cat"
  },
  {
   "id": "BIA_07_11",
   "scene": "BIA_07",
   "speaker": "seven",
   "label": "7",
   "text": "You really have been watching.",
   "direction": "Impressed",
   "action": "Impressed.",
   "voice": "Seven"
  },
  {
   "id": "BIA_07_12",
   "scene": "BIA_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "Mm-hmm.",
   "direction": "Quiet satisfaction",
   "action": "Quiet satisfaction.",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_N1",
   "scene": "BIA_08",
   "speaker": "nela",
   "label": "Nela",
   "text": "The relay beyond this door sits inside the archive's shielding. Nothing reaches through it. Not our sensors, not our thoughts. Not even yours.",
   "direction": "Calm",
   "action": "Calm. *(QF23, Dan's proposed line)*",
   "voice": "nela"
  },
  {
   "id": "BIA_08_01",
   "scene": "BIA_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "I’ll lose you beyond that door.",
   "direction": "",
   "action": "His attention shifts from Ratwing’s marker to hers.",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_02",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "Only until I reach the other side.",
   "direction": "",
   "action": "Checks the route.",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_03",
   "scene": "BIA_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "Mm-hmm.",
   "direction": "",
   "action": "A pause.",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_04",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "I know. I’ll be careful.",
   "direction": "Softens",
   "action": "Softens.",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_05",
   "scene": "BIA_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "I hadn’t said anything.",
   "direction": "Gentle protest",
   "action": "Gentle protest.",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_06",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "You did the pause.",
   "direction": "Small laugh",
   "action": "Small laugh.",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_06a",
   "scene": "BIA_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "My… paws?",
   "direction": "",
   "action": "Genuinely confused; looks down at his front paws, lifts one. *(Dan, 2026-11-21)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_06b",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "Pause. The silence.",
   "direction": "A laugh she can't hold in",
   "action": "A laugh she can't hold in.",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_07",
   "scene": "BIA_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "Ah. An expressive pause.",
   "direction": "Composure returning, sets the paw down very neatly",
   "action": "Composure returning; sets the paw down very neatly; sits beside the console.",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_08",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "See you on the other side.",
   "direction": "",
   "action": "Opens the door.",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_N2",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "An airlock. One door at a time.",
   "direction": "Quietly, to herself",
   "action": "Quietly, to herself. *(QF23, new - Dan to review)*",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_N3",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "No power. Its coupling's on the floor.",
   "direction": "",
   "action": "To herself; crouches. *(QF23, new - Dan to review)*",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_09",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "Panther?",
   "direction": "",
   "action": "Before moving farther.",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_10",
   "scene": "BIA_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "Here.",
   "direction": "Immediate",
   "action": "Immediate.",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_11",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "Good.",
   "direction": "Releases a breath",
   "action": "Releases a breath.",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_12",
   "scene": "BIA_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "How was the silence?",
   "direction": "Lightly",
   "action": "Lightly.",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_13",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "Overrated.",
   "direction": "Small, honest smile in her voice",
   "action": "Small, honest smile in her voice.",
   "voice": "Seven"
  },
  {
   "id": "BIA_08_14",
   "scene": "BIA_08",
   "speaker": "nela",
   "label": "Nela",
   "text": "All three districts are connected. Ratwing is moving toward the archive.",
   "direction": "Urgent but controlled",
   "action": "Urgent but controlled.",
   "voice": "nela"
  },
  {
   "id": "BIA_08_15",
   "scene": "BIA_08",
   "speaker": "cat",
   "label": "Panther",
   "text": "I have him.",
   "direction": "",
   "action": "Turns to the moving marker.",
   "voice": "Cat"
  },
  {
   "id": "BIA_08_16",
   "scene": "BIA_08",
   "speaker": "seven",
   "label": "7",
   "text": "Let’s keep it that way.",
   "direction": "",
   "action": "Runs toward the bike.",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_01",
   "scene": "BIA_09",
   "speaker": "ratwing",
   "label": "Ratwing",
   "text": "Do you have any idea what’s in there?",
   "direction": "",
   "action": "Gestures toward the sealed archive.",
   "voice": "Ratwing"
  },
  {
   "id": "BIA_09_02",
   "scene": "BIA_09",
   "speaker": "seven",
   "label": "7",
   "text": "Enough to know it isn’t yours.",
   "direction": "",
   "action": "Steps into view.",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_03",
   "scene": "BIA_09",
   "speaker": "ratwing",
   "label": "Ratwing",
   "text": "They leave it sitting here. I could make it worth something.",
   "direction": "",
   "action": "Spreads his wings.",
   "voice": "Ratwing"
  },
  {
   "id": "BIA_09_04",
   "scene": "BIA_09",
   "speaker": "seven",
   "label": "7",
   "text": "It already is.",
   "direction": "Quiet and firm",
   "action": "Quiet and firm.",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_N1",
   "scene": "BIA_09",
   "speaker": "nela",
   "label": "Nela",
   "text": "Our partitions can wall off sections of this shaft. Close them and he'll have less and less room to fly, and nowhere left to run.",
   "direction": "Calm, firm",
   "action": "Calm, firm. *(QF23, Dan's proposed line)*",
   "voice": "nela"
  },
  {
   "id": "BIA_09_N2",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "A smaller room. My favourite kind of hunt.",
   "direction": "Dry",
   "action": "Dry. *(QF23, Dan's proposed line)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_S1",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "He's stunned. Hit him now!",
   "direction": "Urgent",
   "action": "Urgent. *(QF23, Dan's proposed line)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_S2",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "He's down. Now!",
   "direction": "Urgent",
   "action": "Urgent. *(QF23, new - Dan to review)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_S3",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "Go, while he's dazed.",
   "direction": "",
   "action": "Quick. *(QF23, new - Dan to review)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_C1",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "Close the partition!",
   "direction": "Sharp",
   "action": "Sharp. *(QF23, Dan's proposed line)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_C2",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "Now the partition. The station's lit!",
   "direction": "Sharp",
   "action": "Sharp. *(QF23, Dan's proposed line)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_B1",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "He doesn't like those.",
   "direction": "Dry, pleased",
   "action": "Dry, pleased. *(QF23, Dan's proposed line)*",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_B2",
   "scene": "BIA_09",
   "speaker": "seven",
   "label": "7",
   "text": "Good.",
   "direction": "Breathless",
   "action": "Breathless. *(QF23, Dan's proposed line)*",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_05",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "Don’t follow him. Watch the opening on your right.",
   "direction": "Low, intent",
   "action": "Low, intent.",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_06",
   "scene": "BIA_09",
   "speaker": "seven",
   "label": "7",
   "text": "I thought following him was the plan.",
   "direction": "",
   "action": "Crouches behind cover.",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_07",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "It was an early draft.",
   "direction": "Dry",
   "action": "Dry, without losing focus.",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_08",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "There. He’s coming back.",
   "direction": "",
   "action": "Watches the approach.",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_09",
   "scene": "BIA_09",
   "speaker": "seven",
   "label": "7",
   "text": "I see him.",
   "direction": "",
   "action": "Hand over the control.",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_10",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "Wait…",
   "direction": "",
   "action": "Tail still; eyes fixed.",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_11",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "Now.",
   "direction": "Sharp and precise",
   "action": "Sharp and precise.",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_12",
   "scene": "BIA_09",
   "speaker": "seven",
   "label": "7",
   "text": "Ha! Got him.",
   "direction": "Breathless relief",
   "action": "Breathless relief; lowers her shoulders.",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_13",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "Mm.",
   "direction": "Deep satisfaction",
   "action": "Deep satisfaction.",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_14",
   "scene": "BIA_09",
   "speaker": "seven",
   "label": "7",
   "text": "That was a very pleased noise.",
   "direction": "Small laugh",
   "action": "Small laugh.",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_15",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "A successful joint effort.",
   "direction": "Composed again",
   "action": "Composed again.",
   "voice": "Cat"
  },
  {
   "id": "BIA_09_16",
   "scene": "BIA_09",
   "speaker": "seven",
   "label": "7",
   "text": "You’re purring.",
   "direction": "Grins in her voice",
   "action": "Grins in her voice.",
   "voice": "Seven"
  },
  {
   "id": "BIA_09_17",
   "scene": "BIA_09",
   "speaker": "cat",
   "label": "Panther",
   "text": "The ship is vibrating.",
   "direction": "Absolutely straight-faced",
   "action": "Absolutely straight-faced.",
   "voice": "Cat"
  },
  {
   "id": "BIA_10_N1",
   "scene": "BIA_10",
   "speaker": "nela",
   "label": "Nela",
   "text": "The archive opens only to all three districts together. The control at its entrance takes each relay's mark, in the order you restored them.",
   "direction": "Calm",
   "action": "Calm. *(QF23, new - Dan to review)*",
   "voice": "nela"
  },
  {
   "id": "BIA_10_01",
   "scene": "BIA_10",
   "speaker": "nela",
   "label": "Nela",
   "text": "We can hear one another clearly again.",
   "direction": "A relieved breath",
   "action": "A relieved breath.",
   "voice": "nela"
  },
  {
   "id": "BIA_10_02",
   "scene": "BIA_10",
   "speaker": "seven",
   "label": "7",
   "text": "Everyone in the closed districts?",
   "direction": "",
   "action": "Still holding the control.",
   "voice": "Seven"
  },
  {
   "id": "BIA_10_03",
   "scene": "BIA_10",
   "speaker": "nela",
   "label": "Nela",
   "text": "Yes. Thank you. Both of you.",
   "direction": "",
   "action": "Looks toward her communicator.",
   "voice": "nela"
  },
  {
   "id": "BIA_10_04",
   "scene": "BIA_10",
   "speaker": "cat",
   "label": "Panther",
   "text": "You’re welcome.",
   "direction": "",
   "action": "Warm beneath his formality.",
   "voice": "Cat"
  },
  {
   "id": "BIA_10_05",
   "scene": "BIA_10",
   "speaker": "seven",
   "label": "7",
   "text": "He was particularly invested.",
   "direction": "Quiet giggle",
   "action": "Quiet giggle.",
   "voice": "Seven"
  },
  {
   "id": "BIA_11_01",
   "scene": "BIA_11",
   "speaker": "nela",
   "label": "Nela",
   "text": "These are memories people chose to leave with us.",
   "direction": "",
   "action": "Walks between the suspended structures.",
   "voice": "nela"
  },
  {
   "id": "BIA_11_02",
   "scene": "BIA_11",
   "speaker": "seven",
   "label": "7",
   "text": "All their memories?",
   "direction": "",
   "action": "Looks around.",
   "voice": "Seven"
  },
  {
   "id": "BIA_11_03",
   "scene": "BIA_11",
   "speaker": "nela",
   "label": "Nela",
   "text": "No. Some things were kept private. Some were never recorded.",
   "direction": "Accepting, matter-of-fact",
   "action": "Accepting, matter-of-fact.",
   "voice": "nela"
  },
  {
   "id": "BIA_11_04",
   "scene": "BIA_11",
   "speaker": "seven",
   "label": "7",
   "text": "And some were lost.",
   "direction": "",
   "action": "Notices an empty position.",
   "voice": "Seven"
  },
  {
   "id": "BIA_11_05",
   "scene": "BIA_11",
   "speaker": "nela",
   "label": "Nela",
   "text": "Yes.",
   "direction": "",
   "action": "Stops beside her.",
   "voice": "nela"
  },
  {
   "id": "BIA_11_06",
   "scene": "BIA_11",
   "speaker": "seven",
   "label": "7",
   "text": "They weren’t sure they wanted to leave it.",
   "direction": "",
   "action": "Fingers lift slowly from the octahedron.",
   "voice": "Seven"
  },
  {
   "id": "BIA_11_07",
   "scene": "BIA_11",
   "speaker": "nela",
   "label": "Nela",
   "text": "What did you see?",
   "direction": "",
   "action": "Gives her room.",
   "voice": "nela"
  },
  {
   "id": "BIA_11_08",
   "scene": "BIA_11",
   "speaker": "seven",
   "label": "7",
   "text": "Someone recording a memory. They waited a long time before they did it.",
   "direction": "Quiet reflection",
   "action": "Quiet reflection.",
   "voice": "Seven"
  },
  {
   "id": "BIA_11_09",
   "scene": "BIA_11",
   "speaker": "seven",
   "label": "7",
   "text": "I remember waiting with them.",
