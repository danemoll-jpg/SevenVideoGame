 "lines": [
  {
   "id": "FIN_01_01",
   "scene": "FIN_01",
   "speaker": "seven",
   "label": "7",
   "text": "Looks smaller from out here.",
   "direction": "",
   "action": "Watches the Moon.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_01_02",
   "scene": "FIN_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "You’ve had a busy few weeks.",
   "direction": "Quietly amused",
   "action": "Quietly amused.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_01_03",
   "scene": "FIN_01",
   "speaker": "seven",
   "label": "7",
   "text": "Last time, all I wanted was to get away from it.",
   "direction": "A small breath of laughter",
   "action": "A small breath of laughter.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_01_04",
   "scene": "FIN_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "An excellent plan at the time.",
   "direction": "",
   "action": "Looks up at her.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_01_05",
   "scene": "FIN_01",
   "speaker": "seven",
   "label": "7",
   "text": "Still could be.",
   "direction": "",
   "action": "Glances down.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_01_06",
   "scene": "FIN_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Let’s park somewhere else.",
   "direction": "Dry",
   "action": "Dry.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_01_07",
   "scene": "FIN_01",
   "speaker": "seven",
   "label": "7",
   "text": "Mm. Somewhere without a prison attached.",
   "direction": "Soft chuckle",
   "action": "Soft chuckle.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_02_01",
   "scene": "FIN_02",
   "speaker": "seven",
   "label": "7",
   "text": "It’s still beautiful.",
   "direction": "Quietly",
   "action": "Quietly.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_02_02",
   "scene": "FIN_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "Yes.",
   "direction": "Lets the view breathe",
   "action": "Lets the view breathe.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_02_03",
   "scene": "FIN_02",
   "speaker": "seven",
   "label": "7",
   "text": "Even knowing what’s underneath it.",
   "direction": "",
   "action": "Looks toward the mining lights.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_02_04",
   "scene": "FIN_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "Especially worth looking after, then.",
   "direction": "Gentle",
   "action": "Gentle.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_02_05",
   "scene": "FIN_02",
   "speaker": "seven",
   "label": "7",
   "text": "Coming with me this time?",
   "direction": "",
   "action": "Looks down as he steps beside her.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_02_06",
   "scene": "FIN_02",
   "speaker": "cat",
   "label": "Panther",
   "text": "You’ve finally found somewhere within walking distance.",
   "direction": "",
   "action": "Tail raised.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_02_07",
   "scene": "FIN_02",
   "speaker": "seven",
   "label": "7",
   "text": "Heh. Come on.",
   "direction": "",
   "action": "Starts down the passage.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_01",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "You came back.",
   "direction": "",
   "action": "Stops working.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_02",
   "scene": "FIN_03",
   "speaker": "seven",
   "label": "7",
   "text": "Mm-hmm. We’re looking for a chamber beneath this level.",
   "direction": "",
   "action": "Shows the map.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_03",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "That section is sealed.",
   "direction": "",
   "action": "Looks toward a surveillance fixture.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_04",
   "scene": "FIN_03",
   "speaker": "seven",
   "label": "7",
   "text": "By Tunneler?",
   "direction": "",
   "action": "Lowers her voice.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_05",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "He says the foundations are unsafe. We are still sent down to maintain his equipment.",
   "direction": "Bitter, tired humour",
   "action": "Bitter, tired humour.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_06",
   "scene": "FIN_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Convenient distinction.",
   "direction": "Quiet",
   "action": "Quiet.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_07",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "This passage is older than the mine. There are marks on the walls like those.",
   "direction": "",
   "action": "Indicates the runes.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_08",
   "scene": "FIN_03",
   "speaker": "seven",
   "label": "7",
   "text": "Can you get us through?",
   "direction": "Open, respectful",
   "action": "Open, respectful.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_09",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "I can open the service route. The inner door has never answered us.",
   "direction": "",
   "action": "Returns to the terminal.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_10",
   "scene": "FIN_03",
   "speaker": "seven",
   "label": "7",
   "text": "Thank you.",
   "direction": "Sincere",
   "action": "Sincere.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_11",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "If there is something down there about us…",
   "direction": "",
   "action": "Hesitates.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_12",
   "scene": "FIN_03",
   "speaker": "seven",
   "label": "7",
   "text": "We’ll bring it back.",
   "direction": "",
   "action": "Meets their gaze.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_03_P1",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "The power for the old route runs through that panel. Switch it back.",
   "direction": "Tired, practical",
   "action": "Tired, practical",
   "voice": "screeworker",
   "repeat": false,
   "proposed": true
  },
  {
   "id": "FIN_03_P2",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "The gate lock rusted shut years ago. We were never strong enough to lift it.",
   "direction": "Bitter, tired",
   "action": "Bitter, tired",
   "voice": "screeworker",
   "repeat": false,
   "proposed": true
  },
  {
   "id": "FIN_03_P3",
   "scene": "FIN_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Narrow walkway. Watch the edge.",
   "direction": "Dry, gentle",
   "action": "Dry, gentle",
   "voice": "cat",
   "repeat": false,
   "proposed": true
  },
  {
   "id": "FIN_03_P4",
   "scene": "FIN_03",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "There. The old route is open. Go carefully.",
   "direction": "Quiet, sincere",
   "action": "Quiet, sincere",
   "voice": "screeworker",
   "repeat": false,
   "proposed": true
  },
  {
   "id": "FIN_04_01",
   "scene": "FIN_04",
   "speaker": "seven",
   "label": "7",
   "text": "I know this door.",
   "direction": "Quiet recognition",
   "action": "Quiet recognition.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_04_02",
   "scene": "FIN_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "From the first vision?",
   "direction": "",
   "action": "Looks up.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_04_03",
   "scene": "FIN_04",
   "speaker": "seven",
   "label": "7",
   "text": "Yes.",
   "direction": "",
   "action": "Steps closer.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_04_05",
   "scene": "FIN_04",
   "speaker": "seven",
   "label": "7",
   "text": "They weren’t surprised to see me.",
   "direction": "",
   "action": "Her hand hovers beside the marking.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_04_06",
   "scene": "FIN_04",
   "speaker": "cat",
   "label": "Panther",
   "text": "No.",
   "direction": "Patient",
   "action": "Patient.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_04_07",
   "scene": "FIN_04",
   "speaker": "seven",
   "label": "7",
   "text": "I think I belonged here.",
   "direction": "",
   "action": "Touches the door.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_05_01",
   "scene": "FIN_05",
   "speaker": "seven",
   "label": "7",
   "text": "We carried all of this without knowing what it was for.",
   "direction": "",
   "action": "Watches the chamber assemble its display.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_05_02",
   "scene": "FIN_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "We knew some of it.",
   "direction": "",
   "action": "Looks toward the images.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_05_03",
   "scene": "FIN_05",
   "speaker": "seven",
   "label": "7",
   "text": "Enough to keep going.",
   "direction": "Small smile",
   "action": "Small smile.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_05_04",
   "scene": "FIN_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "Mm-hmm.",
   "direction": "",
   "action": "Steps beside her.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_05_05",
   "scene": "FIN_05",
   "speaker": "archive",
   "label": "Archive",
   "text": "Records received.",
   "direction": "Soft, restrained",
   "action": "Soft, restrained.",
   "voice": "Archive",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_05_06",
   "scene": "FIN_05",
   "speaker": "archive",
   "label": "Archive",
   "text": "Witness recognized.",
   "direction": "",
   "action": "The central surface illuminates.",
   "voice": "Archive",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_05_07",
   "scene": "FIN_05",
   "speaker": "seven",
   "label": "7",
   "text": "Witness?",
   "direction": "Almost to herself",
   "action": "Almost to herself.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_05_P1",
   "scene": "FIN_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "One for every place we've been.",
   "direction": "Soft, warm",
   "action": "Soft, warm",
   "voice": "cat",
   "repeat": false,
   "proposed": true
  },
  {
   "id": "FIN_06_01",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "They weren’t showing me someone else’s life.",
   "direction": "",
   "action": "Her hand remains on the surface.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_02",
   "scene": "FIN_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Seven?",
   "direction": "Gentle",
   "action": "Gentle.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_03",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "I was there.",
   "direction": "A long breath",
   "action": "A long breath.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_04",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "The gardens. The bridge. That little bird…",
   "direction": "Wonder and grief together",
   "action": "Wonder and grief together.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_05",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "I knew them.",
   "direction": "",
   "action": "Looks toward the images.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_07",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "They’re all gone. And I’m still here.",
   "direction": "Quietly",
   "action": "Quietly.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_08",
   "scene": "FIN_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "You’re here.",
   "direction": "Simple reassurance",
   "action": "Simple reassurance.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_09",
   "scene": "FIN_06",
   "speaker": "archive",
   "label": "Archive",
   "text": "Living testimony available.",
   "direction": "Restrained",
   "action": "Restrained.",
   "voice": "Archive",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_10",
   "scene": "FIN_06",
   "speaker": "archive",
   "label": "Archive",
   "text": "Permission to preserve and share?",
   "direction": "",
   "action": "Waits.",
   "voice": "Archive",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_11",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "That’s why it’s incomplete.",
   "direction": "",
   "action": "Looks at the gaps.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_12",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "The records tell us what they built. But not everything it meant to them.",
   "direction": "",
   "action": "Watches the workshop fragment.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_13",
   "scene": "FIN_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "You remember that part.",
   "direction": "Softly",
   "action": "Softly.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_14",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "Someone should.",
   "direction": "",
   "action": "Her hand settles firmly on the surface.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_06_15",
   "scene": "FIN_06",
   "speaker": "seven",
   "label": "7",
   "text": "Yes. Share it.",
   "direction": "Clear choice",
   "action": "Clear choice.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_01",
   "scene": "FIN_07",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "Seven? We can hear the lower districts. All of them.",
   "direction": "Surprised",
   "action": "Surprised.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_02",
   "scene": "FIN_07",
   "speaker": "seven",
   "label": "7",
   "text": "The chamber is reconnecting the old network.",
   "direction": "",
   "action": "Watching the display.",
   "voice": "seven",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_03",
   "scene": "FIN_07",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "There are records here. Names. Places…",
   "direction": "",
   "action": "Voice catches slightly.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_04",
   "scene": "FIN_07",
   "speaker": "worker2",
   "label": "Scree elder",
   "text": "These controls belong to the city. He locked us out of them.",
   "direction": "Realization",
   "action": "Realization.",
   "voice": "ScreeWorker2",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_05",
   "scene": "FIN_07",
   "speaker": "cat",
   "label": "Panther",
   "text": "Can you stop the drilling around this chamber?",
   "direction": "Practical",
   "action": "Practical.",
   "voice": "cat",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_06",
   "scene": "FIN_07",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "We can reach the controls now. Give us a moment.",
   "direction": "Determined",
   "action": "Determined.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_07",
   "scene": "FIN_07",
   "speaker": "tunneler",
   "label": "Tunneler",
   "text": "Who authorized that shutdown?",
   "direction": "Controlled anger",
   "action": "Controlled anger.",
   "voice": "Tunneler",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_09",
   "scene": "FIN_07",
   "speaker": "tunneler",
   "label": "Tunneler",
   "text": "Return to your stations.",
   "direction": "Sharper",
   "action": "Sharper.",
   "voice": "Tunneler",
   "repeat": false,
   "proposed": false
  },
  {
   "id": "FIN_07_10",
   "scene": "FIN_07",
   "speaker": "worker",
   "label": "Scree worker",
   "text": "We are at our stations.",
   "direction": "Quiet resolve",
   "action": "Quiet resolve.",
   "voice": "screeworker",
   "repeat": false,
   "proposed": false
  },
