   "id": "MAR_12_01",
   "scene": "MAR_12",
   "speaker": "seven",
   "label": "7",
   "text": "They were both so certain.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_12_02",
   "scene": "MAR_12",
   "speaker": "cat",
   "label": "Panther",
   "text": "About the bridge?",
   "direction": "",
   "voice": "Cat"
  },
  {
   "id": "MAR_12_03",
   "scene": "MAR_12",
   "speaker": "seven",
   "label": "7",
   "text": "What if I’m doing that? Taking little pieces and deciding what they mean?",
