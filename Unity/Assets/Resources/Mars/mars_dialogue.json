 ],
 "lines": [
  {
   "id": "MAR_01_01",
   "scene": "MAR_01",
   "speaker": "seven",
   "label": "7",
   "text": "There’s the temple.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_01_02",
   "scene": "MAR_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "And several people determined to make reaching it inconvenient.",
   "direction": "",
   "voice": "Cat"
  },
  {
   "id": "MAR_01_03",
   "scene": "MAR_01",
   "speaker": "seven",
   "label": "7",
   "text": "The guardian did mention borders.",
   "direction": "a small sigh",
   "voice": "Seven"
  },
  {
   "id": "MAR_01_04",
   "scene": "MAR_01",
   "speaker": "cat",
   "label": "Panther",
   "text": "Mm. They appear to have been thorough.",
   "direction": "",
   "voice": "Cat"
  },
  {
   "id": "MAR_02_01",
   "scene": "MAR_02",
   "speaker": "seven",
   "label": "7",
   "text": "I’m looking for the temple.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_02_02",
   "scene": "MAR_02",
   "speaker": "guard",
   "label": "Guard",
   "text": "Crossing is closed.",
   "direction": "",
   "voice": "guard"
  },
  {
   "id": "MAR_02_03",
   "scene": "MAR_02",
   "speaker": "seven",
   "label": "7",
   "text": "For how long?",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_02_04",
   "scene": "MAR_02",
   "speaker": "guard",
   "label": "Guard",
   "text": "Until the other side withdraws.",
   "direction": "",
   "voice": "guard"
  },
  {
   "id": "MAR_02_05",
   "scene": "MAR_02",
   "speaker": "worker",
   "label": "Worker",
   "text": "Those are water filters. They’re waiting for them.",
   "direction": "",
   "voice": "worker"
  },
  {
   "id": "MAR_02_06",
   "scene": "MAR_02",
   "speaker": "guard",
   "label": "Guard",
   "text": "I have my orders.",
   "direction": "",
   "voice": "guard"
  },
  {
   "id": "MAR_02_07",
   "scene": "MAR_02",
   "speaker": "seven",
   "label": "7",
   "text": "Who gives them?",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_03_01",
   "scene": "MAR_03",
   "speaker": "viper",
   "label": "Viper",
   "text": "Someone who understands what happens when we become careless.",
   "direction": "",
   "voice": "Viper"
  },
  {
   "id": "MAR_03_02",
   "scene": "MAR_03",
   "speaker": "seven",
   "label": "7",
   "text": "They need those supplies.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_03_03",
   "scene": "MAR_03",
   "speaker": "viper",
   "label": "Viper",
   "text": "Then they can accept our terms.",
   "direction": "",
   "voice": "Viper"
  },
  {
   "id": "MAR_03_04",
   "scene": "MAR_03",
   "speaker": "seven",
   "label": "7",
   "text": "And the temple?",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_03_05",
   "scene": "MAR_03",
   "speaker": "viper",
   "label": "Viper",
   "text": "What business do you have there?",
   "direction": "",
   "voice": "Viper"
  },
  {
   "id": "MAR_03_06",
   "scene": "MAR_03",
   "speaker": "seven",
   "label": "7",
   "text": "Historical.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_03_07",
   "scene": "MAR_03",
   "speaker": "viper",
   "label": "Viper",
   "text": "History is precisely the problem.",
   "direction": "a dry, dismissive laugh",
   "voice": "Viper"
  },
  {
   "id": "MAR_03_08",
   "scene": "MAR_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "Charming.",
   "direction": "privately",
   "voice": "Cat"
  },
  {
   "id": "MAR_03_09",
   "scene": "MAR_03",
   "speaker": "seven",
   "label": "7",
   "text": "He noticed the records.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_03_10",
   "scene": "MAR_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "I noticed him noticing.",
   "direction": "",
   "voice": "Cat"
  },
  {
   "id": "MAR_03_11",
   "scene": "MAR_03",
   "speaker": "worker",
   "label": "Worker",
   "text": "There's an old maintenance route under the crossing. The builders used it.",
   "direction": "quietly",
   "action": "quietly, with a glance at the guard",
   "voice": "worker"
  },
  {
   "id": "MAR_03_12",
   "scene": "MAR_03",
   "speaker": "seven",
   "label": "7",
   "text": "Can the transport get through?",
   "direction": "",
   "action": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_03_13",
   "scene": "MAR_03",
   "speaker": "worker",
   "label": "Worker",
   "text": "Not anymore. The service gate's been dead for years.",
   "direction": "",
   "action": "",
   "voice": "worker"
  },
  {
   "id": "MAR_03_14",
   "scene": "MAR_03",
   "speaker": "seven",
   "label": "7",
   "text": "Then I'll take a look.",
   "direction": "",
   "action": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_03_15",
   "scene": "MAR_03",
   "speaker": "cat",
   "label": "Panther",
   "text": "I see it from here. A ramp cut into the bank, east of you.",
   "direction": "",
   "action": "telepathic",
   "voice": "Cat"
  },
  {
   "id": "MAR_04_01",
   "scene": "MAR_04",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "You brought the filters through?",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_04_02",
   "scene": "MAR_04",
   "speaker": "seven",
   "label": "7",
   "text": "Helped them through.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_04_03",
   "scene": "MAR_04",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "Hm. We were told nobody over there would let them leave.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_04_04",
   "scene": "MAR_04",
   "speaker": "seven",
   "label": "7",
   "text": "The people carrying them seemed quite determined.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_04_05",
   "scene": "MAR_04",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "That is not what we’ve been hearing.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_05_01",
   "scene": "MAR_05",
   "speaker": "seven",
   "label": "7",
   "text": "Two controls?",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_05_02",
   "scene": "MAR_05",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "One on each bank.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_05_03",
   "scene": "MAR_05",
   "speaker": "seven",
   "label": "7",
   "text": "So both sides have to open it.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_05_04",
   "scene": "MAR_05",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "That was the intention.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_05_05",
   "scene": "MAR_05",
   "speaker": "cat",
   "label": "Panther",
   "text": "Rather optimistic architecture.",
   "direction": "",
   "voice": "Cat"
  },
  {
   "id": "MAR_05_06",
   "scene": "MAR_05",
   "speaker": "seven",
   "label": "7",
   "text": "Or they used to trust each other.",
   "direction": "quietly",
   "voice": "Seven"
  },
  {
   "id": "MAR_05_07",
   "scene": "MAR_05",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "He tells each bank the other intends to seize the temple.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_05_08",
   "scene": "MAR_05",
   "speaker": "seven",
   "label": "7",
   "text": "Does either one?",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_05_09",
   "scene": "MAR_05",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "Some would. Others just want the bridge open.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_06_V1",
   "scene": "MAR_06",
   "speaker": "seven",
   "label": "7",
   "text": "The service route's open. The caretaker on the far bank will work the other control.",
   "direction": "",
   "action": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_06_V2",
   "scene": "MAR_06",
   "speaker": "worker",
   "label": "Worker",
   "text": "The caretaker? From over there?",
   "direction": "surprised",
   "action": "surprised",
   "voice": "worker"
  },
  {
   "id": "MAR_06_V3",
   "scene": "MAR_06",
   "speaker": "seven",
   "label": "7",
   "text": "They're waiting for someone on this side.",
   "direction": "",
   "action": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_06_V4",
   "scene": "MAR_06",
   "speaker": "worker",
   "label": "Worker",
   "text": "Then I'll go. Someone should.",
   "direction": "",
   "action": "a beat; a glance at the guard first",
   "voice": "worker"
  },
  {
   "id": "MAR_06_V5",
   "scene": "MAR_06",
   "speaker": "seven",
   "label": "7",
   "text": "Thank you.",
   "direction": "warmly",
   "action": "warmly",
   "voice": "Seven"
  },
  {
   "id": "MAR_06_V6",
   "scene": "MAR_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Two volunteers. Practically a treaty.",
   "direction": "dry",
   "action": "telepathic, dry",
   "voice": "Cat"
  },
  {
   "id": "MAR_06_P1",
   "scene": "MAR_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "The power stops under the bridge. Something down there's knocked loose.",
   "direction": "",
   "action": "telepathic",
   "voice": "Cat"
  },
  {
   "id": "MAR_06_D1",
   "scene": "MAR_06",
   "speaker": "viper",
   "label": "Viper",
   "text": "You've been busy. Let's see how you manage several things at once.",
   "direction": "cold, amused",
   "action": "over a loudspeaker; cold, amused",
   "voice": "Viper"
  },
  {
   "id": "MAR_06_D2",
   "scene": "MAR_06",
   "speaker": "worker",
   "label": "Worker",
   "text": "Those are his sentries — they'll wreck the control!",
   "direction": "alarmed",
   "action": "alarmed, pointing",
   "voice": "worker"
  },
  {
   "id": "MAR_06_D3",
   "scene": "MAR_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Three of them. All heading for the worker.",
   "direction": "quick",
   "action": "telepathic, quick",
   "voice": "Cat"
  },
  {
   "id": "MAR_06_D4",
   "scene": "MAR_06",
   "speaker": "seven",
   "label": "7",
   "text": "Not if I can help it.",
   "direction": "",
   "action": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_06_D5",
   "scene": "MAR_06",
   "speaker": "viper",
   "label": "Viper",
   "text": "Every bridge has a weak point.",
   "direction": "",
   "action": "mid-fight taunt, over the loudspeaker",
   "voice": "Viper"
  },
  {
   "id": "MAR_06_D6",
   "scene": "MAR_06",
   "speaker": "viper",
   "label": "Viper",
   "text": "Enjoy it. Bridges fall.",
   "direction": "",
   "action": "after the last sentry goes down",
   "voice": "Viper"
  },
  {
   "id": "MAR_06_H1",
   "scene": "MAR_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "The caretaker's at the far control. They've raised a lamp — they're ready.",
   "direction": "",
   "action": "telepathic; cut to the far bank: the caretaker at their control raising a lamp",
   "voice": "Cat"
  },
  {
   "id": "MAR_06_H2",
   "scene": "MAR_06",
   "speaker": "seven",
   "label": "7",
   "text": "The other side is ready. Hold until I say.",
   "direction": "",
   "action": "to the worker beside her",
   "voice": "Seven"
  },
  {
   "id": "MAR_06_H3",
   "scene": "MAR_06",
   "speaker": "worker",
   "label": "Worker",
   "text": "Holding.",
   "direction": "",
   "action": "hands on the wheel",
   "voice": "worker"
  },
  {
   "id": "MAR_06_H4",
   "scene": "MAR_06",
   "speaker": "seven",
   "label": "7",
   "text": "Not that one!",
   "direction": "a startled breath",
   "action": "a startled breath",
   "voice": "Seven"
  },
  {
   "id": "MAR_06_H5",
   "scene": "MAR_06",
   "speaker": "cat",
   "label": "Panther",
   "text": "Specificity. Always helpful.",
   "direction": "dry",
   "action": "dry",
   "voice": "Cat"
  },
  {
   "id": "MAR_06_H6",
   "scene": "MAR_06",
   "speaker": "seven",
   "label": "7",
   "text": "Now!",
   "direction": "relieved laugh",
   "action": "a short, relieved laugh",
   "voice": "Seven"
  },
  {
   "id": "MAR_07_01",
   "scene": "MAR_07",
   "speaker": "viper",
   "label": "Viper",
   "text": "Do you know what you’ve opened?",
   "direction": "",
   "voice": "Viper"
  },
  {
   "id": "MAR_07_02",
   "scene": "MAR_07",
   "speaker": "seven",
   "label": "7",
   "text": "A bridge.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_07_03",
   "scene": "MAR_07",
   "speaker": "viper",
   "label": "Viper",
   "text": "A way for them to come through.",
   "direction": "",
   "voice": "Viper"
  },
  {
   "id": "MAR_07_04",
   "scene": "MAR_07",
   "speaker": "seven",
   "label": "7",
   "text": "It goes both ways.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_07_05",
   "scene": "MAR_07",
   "speaker": "viper",
   "label": "Viper",
   "text": "That is what concerns me.",
   "direction": "",
   "voice": "Viper"
  },
  {
   "id": "MAR_07_06",
   "scene": "MAR_07",
   "speaker": "viper",
   "label": "Viper",
   "text": "They’ll turn on each other again.",
   "direction": "",
   "voice": "Viper"
  },
  {
   "id": "MAR_07_07",
   "scene": "MAR_07",
   "speaker": "seven",
   "label": "7",
   "text": "That’s their choice. You don’t get to make it for them.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_08_01",
   "scene": "MAR_08",
   "speaker": "worker",
   "label": "Worker",
   "text": "That’s ours.",
   "direction": "",
   "voice": "worker"
  },
  {
   "id": "MAR_08_02",
   "scene": "MAR_08",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "And that is ours.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_08_03",
   "scene": "MAR_08",
   "speaker": "seven",
   "label": "7",
   "text": "They’re part of the same design.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_09_01",
   "scene": "MAR_09",
   "speaker": "seven",
   "label": "7",
   "text": "They built it together.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_09_02",
   "scene": "MAR_09",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "The temple?",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_09_03",
   "scene": "MAR_09",
   "speaker": "seven",
   "label": "7",
   "text": "The bridge. Both sides.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_09_04",
   "scene": "MAR_09",
   "speaker": "worker",
   "label": "Worker",
   "text": "We were taught it was taken from us.",
   "direction": "",
   "voice": "worker"
  },
  {
   "id": "MAR_09_05",
   "scene": "MAR_09",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "So were we.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_09_06",
   "scene": "MAR_09",
   "speaker": "seven",
   "label": "7",
   "text": "Then people should see this.",
   "direction": "softly",
   "voice": "Seven"
  },
  {
   "id": "MAR_10_01",
   "scene": "MAR_10",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "Our keepers traded records along this route.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_10_02",
   "scene": "MAR_10",
   "speaker": "seven",
   "label": "7",
   "text": "It stops.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_10_03",
   "scene": "MAR_10",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "The rest was never kept here. Another temple held it.",
   "direction": "",
   "voice": "caretaker"
  },
  {
   "id": "MAR_10_04",
   "scene": "MAR_10",
   "speaker": "worker",
   "label": "Worker",
   "text": "What do you expect to find?",
   "direction": "",
   "voice": "worker"
  },
  {
   "id": "MAR_10_05",
   "scene": "MAR_10",
   "speaker": "seven",
   "label": "7",
   "text": "I’m trying not to decide before I get there.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_10_06",
   "scene": "MAR_10",
   "speaker": "cat",
   "label": "Panther",
   "text": "Received. Part of a route.",
   "direction": "",
   "voice": "Cat"
  },
  {
   "id": "MAR_10_07",
   "scene": "MAR_10",
   "speaker": "seven",
   "label": "7",
   "text": "We’ll look at it together.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_11_P1",
   "scene": "MAR_11",
   "speaker": "guard",
   "label": "Guard",
   "text": "The next load comes at dusk.",
   "direction": "stiff, formal",
   "action": "stiff, formal",
   "voice": "guard"
  },
  {
   "id": "MAR_11_P2",
   "scene": "MAR_11",
   "speaker": "caretaker",
   "label": "Caretaker",
   "text": "We'll have the gate open.",
   "direction": "calm",
   "action": "calm",
   "voice": "caretaker"
  },
  {
   "id": "MAR_11_P3",
   "scene": "MAR_11",
   "speaker": "guard",
   "label": "Guard",
   "text": "…Good.",
   "direction": "",
   "action": "after a pause",
