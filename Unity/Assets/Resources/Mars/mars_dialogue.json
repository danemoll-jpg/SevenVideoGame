  {
   "id": "MAR_12_07",
   "scene": "MAR_12",
   "speaker": "seven",
   "label": "7",
   "text": "Oh, I know you will.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_13U_01",
   "scene": "MAR_13U",
   "speaker": "seven",
   "label": "7",
   "text": "Does the record tell us where they went?",
