   "scene": "MAR_11",
   "speaker": "seven",
   "label": "7",
   "text": "No.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_11_03",
   "scene": "MAR_11",
   "speaker": "seven",
   "label": "7",
   "text": "Got them talking.",
   "direction": "",
   "voice": "Seven"
  },
  {
   "id": "MAR_11_04",
   "scene": "MAR_11",
   "speaker": "cat",
   "label": "Panther",
   "text": "A productive afternoon, then.",
