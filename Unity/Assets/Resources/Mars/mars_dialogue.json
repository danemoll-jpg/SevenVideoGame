   "action": "quiet exhale",
   "voice": "Seven"
  },
  {
   "id": "MAR_13U_04",
   "scene": "MAR_13U",
   "speaker": "cat",
   "label": "Panther",
   "text": "Mm-hmm. We still have the Cetaceans on Europa. Perhaps they remember something the people here lost.",
