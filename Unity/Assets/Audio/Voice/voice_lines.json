{
 "lines": [
  {
   "id": "s01_01_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "Hey. You shouldn't be here.",
   "pauseAfter": 0.45,
   "delivery": "gentle, surprised"
  },
  {
   "id": "s01_02_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "Go on. Before somebody sees you.",
   "pauseAfter": 0.45,
   "delivery": "softly, shooing"
  },
  {
   "id": "s01_03_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "That would make rescuing you considerably harder.",
   "pauseAfter": 0.45
  },
  {
   "id": "s01_04_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "Who said that?",
   "pauseAfter": 0.45,
   "delivery": "startled"
  },
  {
   "id": "s01_05_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "The cat.",
   "pauseAfter": 0.45
  },
  {
   "id": "s01_06_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "You're in my head.",
   "pauseAfter": 0.45,
   "delivery": "wary, curious"
  },
  {
   "id": "s01_07_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "Only conversationally.",
   "pauseAfter": 2.0
  },
  {
   "id": "s01_08_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "You came to rescue me?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s01_09_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "Yes. We should probably do that first.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_01_cat",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "cat",
   "text": "Stand back from the door.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_02_7",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "seven",
   "text": "You know how to open it?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s02_03_cat",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "cat",
   "text": "I wouldn't have asked you to stand back otherwise.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_04_7",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "seven",
   "text": "Thank you.",
   "pauseAfter": 0.45,
   "delivery": "sincere"
  },
  {
   "id": "s02_05_cat",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "cat",
   "text": "You're welcome.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_06_7",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "seven",
   "text": "Which way?",
   "pauseAfter": 0.45,
   "delivery": "focused"
  },
  {
   "id": "s02_07_cat",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "cat",
   "text": "My way in may be unsuitable for you.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_08_7",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "seven",
   "text": "Then we'll find another way.",
   "pauseAfter": 0.45,
   "delivery": "determined"
  },
  {
   "id": "s03_01_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "Who sent you?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s03_02_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "My people.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_03_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "To rescue me specifically?",
   "pauseAfter": 0.45,
   "delivery": "puzzled"
  },
  {
   "id": "s03_04_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "Yes.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_05_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "Why?",
   "pauseAfter": 0.45,
   "delivery": "softly"
  },
  {
   "id": "s03_06_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "They didn't tell me.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_07_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "And you came anyway?",
   "pauseAfter": 0.45,
   "delivery": "warm"
  },
  {
   "id": "s03_08_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "You were in a prison. That seemed reason enough.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_09_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "Do you know why they're holding me?",
   "pauseAfter": 0.45,
   "delivery": "thoughtful"
  },
  {
   "id": "s03_10_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "No. I was hoping you could explain that part.",
   "pauseAfter": 0.45
  },
  {
   "id": "s04_01_7",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "seven",
   "text": "This wall is different.",
   "pauseAfter": 0.45,
   "delivery": "observant"
  },
  {
   "id": "s04_02_cat",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "cat",
   "text": "Older.",
   "pauseAfter": 0.45
  },
  {
   "id": "s04_03_7",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "seven",
   "text": "The prison was built around it.",
   "pauseAfter": 0.45,
   "delivery": "thoughtful"
  },
  {
   "id": "s04_04_cat",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "cat",
   "text": "Convenient. I'd prefer a way out that wasn't designed by the people keeping you in.",
   "pauseAfter": 0.45
  },
  {
   "id": "s04_05_7",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "seven",
   "text": "Let's see where it goes.",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s05_01_cat",
   "scene": 5,
   "dir": "s05_scree",
   "speaker": "cat",
   "text": "Can we get past?",
   "pauseAfter": 0.45
  },
  {
   "id": "s05_02_7",
   "scene": 5,
   "dir": "s05_scree",
   "speaker": "seven",
   "text": "Yes. Without hurting them.",
   "pauseAfter": 0.45,
   "delivery": "calm, firm"
  },
  {
   "id": "s05_03_cat",
   "scene": 5,
   "dir": "s05_scree",
   "speaker": "cat",
   "text": "I was rather hoping you'd say that.",
   "pauseAfter": 0.45
  },
  {
   "id": "s05_04_7",
   "scene": 5,
   "dir": "s05_scree",
   "speaker": "seven",
   "text": "Come on. Before they find another way around.",
   "pauseAfter": 0.45,
   "delivery": "urgent, quiet"
  },
  {
   "id": "s06_01_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "What is it?",
   "pauseAfter": 2.0
  },
  {
   "id": "s06_02_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "Can you hear me?",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_03_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "Yes.",
   "pauseAfter": 0.45,
   "delivery": "dazed"
  },
  {
   "id": "s06_04_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "You weren't answering.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_05_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "This place was different.",
   "pauseAfter": 0.45,
   "delivery": "awed, quiet"
  },
  {
   "id": "s06_06_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "Different how?",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_07_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "Whole. There were people here.",
   "pauseAfter": 0.45,
   "delivery": "wistful"
  },
  {
   "id": "s06_08_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "I didn't see them.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_09_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "I know.",
   "pauseAfter": 0.45,
   "delivery": "softly"
  },
  {
   "id": "s06_10_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "I think I know how to get through.",
   "pauseAfter": 0.45,
   "delivery": "thoughtful"
  },
  {
   "id": "s06_11_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "From what you saw?",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_12_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "Let me try.",
   "pauseAfter": 0.45,
   "delivery": "determined"
  },
  {
   "id": "s06_13_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "We should talk about that.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_14_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "When we're out.",
   "pauseAfter": 0.45,
   "delivery": "focused"
  },
  {
   "id": "s06_15_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "Agreed.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06b_01_7",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "seven",
   "text": "All this was above us?",
   "pauseAfter": 0.45,
   "delivery": "awed, quiet"
  },
  {
   "id": "s06b_02_cat",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "cat",
   "text": "Most of it.",
   "pauseAfter": 2.5
  },
  {
   "id": "s06b_03_7",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "seven",
   "text": "Someone built this.",
   "pauseAfter": 0.45,
   "delivery": "wonder"
  },
  {
   "id": "s06b_04_cat",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "cat",
   "text": "Yes.",
   "pauseAfter": 3.0
  },
  {
   "id": "s06b_05_7",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "seven",
   "text": "And they're taking it apart.",
   "pauseAfter": 0.45,
   "delivery": "sad"
  },
  {
   "id": "s06b_a01_7",
   "scene": 66,
   "dir": "s06b_city_reveal",
   "speaker": "seven",
   "text": "I didn't know all this was here.",
   "pauseAfter": 0.45,
   "delivery": "awed"
  },
  {
   "id": "s06b_a02_cat",
   "scene": 66,
   "dir": "s06b_city_reveal",
   "speaker": "cat",
   "text": "You couldn't see much from where they put you.",
   "pauseAfter": 2.0
  },
  {
   "id": "s06b_a03_7",
   "scene": 66,
   "dir": "s06b_city_reveal",
   "speaker": "seven",
   "text": "How old is it?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s06b_a04_cat",
   "scene": 66,
   "dir": "s06b_city_reveal",
   "speaker": "cat",
   "text": "I don't know.",
   "pauseAfter": 2.5
  },
  {
   "id": "s07_01_7",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "seven",
   "text": "There. That's my ship.",
   "pauseAfter": 0.45,
   "delivery": "relieved"
  },
  {
   "id": "s07_02_cat",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "cat",
   "text": "The saucer?",
   "pauseAfter": 0.45
  },
  {
   "id": "s07_03_7",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "seven",
   "text": "Yes.",
   "pauseAfter": 0.45,
   "delivery": "wry"
  },
  {
   "id": "s07_04_cat",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "cat",
   "text": "Good. I was beginning to worry you meant one of the mining carts.",
   "pauseAfter": 0.45
  },
  {
   "id": "s07_05_7",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "seven",
   "text": "We need to get down there and release it.",
   "pauseAfter": 0.45,
   "delivery": "determined"
  },
  {
   "id": "s07_06_cat",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "cat",
   "text": "Then we have a destination.",
   "pauseAfter": 0.45
  },
  {
   "id": "s08_01_7",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "seven",
   "text": "Get aboard.",
   "pauseAfter": 0.45,
   "delivery": "urgent"
  },
  {
   "id": "s08_02_cat",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "cat",
   "text": "After you.",
   "pauseAfter": 0.45
  },
  {
   "id": "s08_03_7",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "seven",
   "text": "You don't know how to fly it.",
   "pauseAfter": 0.45,
   "delivery": "wry"
  },
  {
   "id": "s08_04_cat",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "cat",
   "text": "An excellent reason for you to go first.",
   "pauseAfter": 0.45
  },
  {
   "id": "s09_01_cat",
   "scene": 9,
   "dir": "s09_interior",
   "speaker": "cat",
   "text": "This is considerably more ship than I was expecting.",
   "pauseAfter": 0.45
  },
  {
   "id": "s09_02_7",
   "scene": 9,
   "dir": "s09_interior",
   "speaker": "seven",
   "text": "Is that a complaint?",
   "pauseAfter": 0.45,
   "delivery": "amused"
  },
  {
   "id": "s09_03_cat",
   "scene": 9,
   "dir": "s09_interior",
   "speaker": "cat",
   "text": "I'm reserving judgment until I find the kitchen.",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_01_7",
   "scene": 10,
   "dir": "s10_meal",
   "speaker": "seven",
   "text": "So, what do you eat? Canned food?",
   "pauseAfter": 0.45,
   "delivery": "playful"
  },
  {
   "id": "s10_02_cat",
   "scene": 10,
   "dir": "s10_meal",
   "speaker": "cat",
   "text": "Chicken. But only free-range.",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_03_7",
   "scene": 10,
   "dir": "s10_meal",
   "speaker": "seven",
   "text": "You're particular for someone I just met in a prison.",
   "pauseAfter": 0.45,
   "delivery": "wry, amused"
  },
  {
   "id": "s10_04_cat",
   "scene": 10,
   "dir": "s10_meal",
   "speaker": "cat",
   "text": "Having experienced confinement, I feel strongly about it.",
   "pauseAfter": 0.45
  },
  {
   "id": "s11_01_7",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "seven",
   "text": "What happens now? Do you go back?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s11_02_cat",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "cat",
   "text": "I was sent to get you out. You're out.",
   "pauseAfter": 0.45
  },
  {
   "id": "s11_03_7",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "seven",
   "text": "I thought you were supposed to help me.",
   "pauseAfter": 0.45,
   "delivery": "hesitant"
  },
  {
   "id": "s11_04_cat",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "cat",
   "text": "I did.",
   "pauseAfter": 1.6
  },
  {
   "id": "s11_05_7",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "seven",
   "text": "With what happened down there, I mean.",
   "pauseAfter": 0.45,
   "delivery": "thoughtful"
  },
  {
   "id": "s11_06_cat",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "cat",
   "text": "I don't know what happened down there.",
   "pauseAfter": 0.45
  },
  {
   "id": "s11_07_7",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "seven",
   "text": "Neither do I.",
   "pauseAfter": 2.5,
   "delivery": "quiet"
  },
  {
   "id": "s11_08_cat",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "cat",
   "text": "Then perhaps I should stay.",
   "pauseAfter": 0.45
  },
  {
   "id": "s11_09_7",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "seven",
   "text": "You don't have to.",
   "pauseAfter": 0.45,
   "delivery": "sincere"
  },
  {
   "id": "s11_10_cat",
   "scene": 11,
   "dir": "s11_stay",
   "speaker": "cat",
   "text": "I know.",
   "pauseAfter": 0.45
  }
 ]
}