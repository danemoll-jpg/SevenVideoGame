{
 "lines": [
  {
   "id": "s01_01_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "Hey. You shouldn't be here.",
   "pauseAfter": 0.45,
   "delivery": "gentle, surprised"
  },
  {
   "id": "s01_02_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "Go on. Before somebody sees you.",
   "pauseAfter": 0.45,
   "delivery": "urgent, hushed, emphatic"
  },
  {
   "id": "s01_03_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "That would make rescuing you considerably harder.",
   "pauseAfter": 0.45
  },
  {
   "id": "s01_04_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "Who said that?",
   "pauseAfter": 0.45,
   "delivery": "startled"
  },
  {
   "id": "s01_05_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "The cat.",
   "pauseAfter": 0.45
  },
  {
   "id": "s01_06_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "You're in my head.",
   "pauseAfter": 0.45,
   "delivery": "wary, curious"
  },
  {
   "id": "s01_07_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "Only conversationally.",
   "pauseAfter": 0.45
  },
  {
   "id": "s01_07a_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "I've spoken mind to mind with a lot of people. Never a cat.",
   "pauseAfter": 0.45,
   "delivery": "intrigued, studying him"
  },
  {
   "id": "s01_07b_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "We don't usually have much to say.",
   "pauseAfter": 2.0
  },
  {
   "id": "s01_08_7",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "seven",
   "text": "You came to rescue me?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s01_09_cat",
   "scene": 1,
   "dir": "s01_first_contact",
   "speaker": "cat",
   "text": "Yes. We should probably do that first.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_01_cat",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "cat",
   "text": "Stand back from the door.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_02_7",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "seven",
   "text": "You know how to open it?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s02_03_cat",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "cat",
   "text": "I wouldn't have asked you to stand back otherwise.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_04_7",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "seven",
   "text": "Thank you.",
   "pauseAfter": 0.45,
   "delivery": "sincere"
  },
  {
   "id": "s02_05_cat",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "cat",
   "text": "You're welcome.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_06_7",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "seven",
   "text": "Which way?",
   "pauseAfter": 0.45,
   "delivery": "focused"
  },
  {
   "id": "s02_07_cat",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "cat",
   "text": "My way in may be unsuitable for you.",
   "pauseAfter": 0.45
  },
  {
   "id": "s02_08_7",
   "scene": 2,
   "dir": "s02_opening_cell",
   "speaker": "seven",
   "text": "Then we'll find another way.",
   "pauseAfter": 0.45,
   "delivery": "determined"
  },
  {
   "id": "s03_01_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "Who sent you?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s03_02_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "My people.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_03_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "To rescue me specifically?",
   "pauseAfter": 0.45,
   "delivery": "puzzled"
  },
  {
   "id": "s03_04_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "Yes.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_05_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "Why?",
   "pauseAfter": 0.45,
   "delivery": "softly"
  },
  {
   "id": "s03_06_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "They didn't tell me.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_07_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "And you came anyway?",
   "pauseAfter": 0.45,
   "delivery": "warm"
  },
  {
   "id": "s03_08_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "You were in a prison. That seemed reason enough.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_09_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "Do you know why they're holding me?",
   "pauseAfter": 0.45,
   "delivery": "thoughtful"
  },
  {
   "id": "s03_10_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "No. I was hoping you could explain that part.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_11_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "Who runs this place?",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s03_12_cat",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "cat",
   "text": "He calls himself Tunneler. He mines the Moon. The Scree do the digging.",
   "pauseAfter": 0.45
  },
  {
   "id": "s03_13_7",
   "scene": 3,
   "dir": "s03_what_he_knows",
   "speaker": "seven",
   "text": "Tunneler.",
   "pauseAfter": 0.45,
   "delivery": "quietly"
  },
  {
   "id": "s04_01_7",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "seven",
   "text": "This wall is different.",
   "pauseAfter": 0.45,
   "delivery": "observant"
  },
  {
   "id": "s04_02_cat",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "cat",
   "text": "Older.",
   "pauseAfter": 0.45
  },
  {
   "id": "s04_03_7",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "seven",
   "text": "The prison was built around it.",
   "pauseAfter": 0.45,
   "delivery": "thoughtful"
  },
  {
   "id": "s04_04_cat",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "cat",
   "text": "Convenient. I'd prefer a way out that wasn't designed by the people keeping you in.",
   "pauseAfter": 0.45
  },
  {
   "id": "s04_05_7",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "seven",
   "text": "Let's see where it goes.",
   "pauseAfter": 0.45,
   "delivery": "curious"
  },
  {
   "id": "s04_T1_tunneler",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "tunneler",
   "text": "The prisoner is not to leave the lower level. Find her.",
   "pauseAfter": 0.45
  },
  {
   "id": "s04_G1_cat",
   "scene": 4,
   "dir": "s04_escape_route",
   "speaker": "cat",
   "text": "Follow the light. I'll show you the way.",
   "pauseAfter": 0.45
  },
  {
   "id": "s05_01_cat",
   "scene": 5,
   "dir": "s05_scree",
   "speaker": "cat",
   "text": "Can we get past?",
   "pauseAfter": 0.45
  },
  {
   "id": "s05_02_7",
   "scene": 5,
   "dir": "s05_scree",
   "speaker": "seven",
   "text": "Yes. Without hurting them.",
   "pauseAfter": 0.45,
   "delivery": "calm, firm"
  },
  {
   "id": "s05_03_cat",
   "scene": 5,
   "dir": "s05_scree",
   "speaker": "cat",
   "text": "I was rather hoping you'd say that.",
   "pauseAfter": 0.45
  },
  {
   "id": "s05_04_7",
   "scene": 5,
   "dir": "s05_scree",
   "speaker": "seven",
   "text": "Come on. Before they find another way around.",
   "pauseAfter": 0.45,
   "delivery": "urgent, quiet"
  },
  {
   "id": "s06_01_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "What is it?",
   "pauseAfter": 2.0
  },
  {
   "id": "s06_02_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "Can you hear me?",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_03_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "Yes.",
   "pauseAfter": 0.45,
   "delivery": "dazed"
  },
  {
   "id": "s06_04_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "You weren't answering.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_05_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "There were others here.",
   "pauseAfter": 0.45,
   "delivery": "awed, quiet"
  },
  {
   "id": "s06_06_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "When?",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_07_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "I don't know.",
   "pauseAfter": 0.45,
   "delivery": "softly, uncertain"
  },
  {
   "id": "s06_08_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "But I think I know how this opens.",
   "pauseAfter": 0.45,
   "delivery": "thoughtful, determined"
  },
  {
   "id": "s06_09_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "We should talk about that.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06_10_7",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "seven",
   "text": "When we're out.",
   "pauseAfter": 0.45,
   "delivery": "focused"
  },
  {
   "id": "s06_11_cat",
   "scene": 6,
   "dir": "s06_vision",
   "speaker": "cat",
   "text": "Agreed.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06b_01_7",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "seven",
   "text": "I've never seen the inside of a moon before.",
   "pauseAfter": 0.45,
   "delivery": "awed, quiet"
  },
  {
   "id": "s06b_02_cat",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "cat",
   "text": "Most people insist on looking at the outside.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06b_03_7",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "seven",
   "text": "Are those cars?",
   "pauseAfter": 0.45,
   "delivery": "wonder, a little amused"
  },
  {
   "id": "s06b_04_cat",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "cat",
   "text": "Apparently we escaped just in time for traffic.",
   "pauseAfter": 0.45
  },
  {
   "id": "s06b_05_7",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "seven",
   "text": "There are people living all the way up there.",
   "pauseAfter": 0.45,
   "delivery": "quiet wonder, almost to herself"
  },
  {
   "id": "s06b_T1_cat",
   "scene": 65,
   "dir": "s06b_city_reveal",
   "speaker": "cat",
   "text": "All of that is his.",
   "pauseAfter": 0.45
  },
  {
   "id": "s07_01_cat",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "cat",
   "text": "That saucer down there… is that your ship?",
   "pauseAfter": 0.45
  },
  {
   "id": "s07_02_7",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "seven",
   "text": "That's her.",
   "pauseAfter": 0.45,
   "delivery": "relieved"
  },
  {
   "id": "s07_03_cat",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "cat",
   "text": "Good. For a moment I thought you were going to point at one of the mining carts.",
   "pauseAfter": 0.45
  },
  {
   "id": "s07_04_7",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "seven",
   "text": "No.",
   "pauseAfter": 0.45,
   "delivery": "laughs"
  },
  {
   "id": "s07_05_cat",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "cat",
   "text": "They've locked it down. Clamps on every side.",
   "pauseAfter": 0.45
  },
  {
   "id": "s07_06_7",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "seven",
   "text": "Then we'll have to find a way to free it.",
   "pauseAfter": 0.45,
   "delivery": "determined"
  },
  {
   "id": "s07_07_cat",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "cat",
   "text": "Then we have a destination.",
   "pauseAfter": 0.45
  },
  {
   "id": "s07_L1_cat",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "cat",
   "text": "There's the release. Up on the gantry. Neither of us can reach that.",
   "pauseAfter": 0.45
  },
  {
   "id": "s07_L2_7",
   "scene": 7,
   "dir": "s07_saucer",
   "speaker": "seven",
   "text": "I don't need to.",
   "pauseAfter": 0.45,
   "delivery": "small smile"
  },
  {
   "id": "s08_01_7",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "seven",
   "text": "Get aboard!",
   "pauseAfter": 0.45,
   "delivery": "urgent, shouting"
  },
  {
   "id": "s08_02_cat",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "cat",
   "text": "Into the glowing beam.",
   "pauseAfter": 0.45
  },
  {
   "id": "s08_03_7",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "seven",
   "text": "It's a tractor beam. It's perfectly safe.",
   "pauseAfter": 0.45,
   "delivery": "reassuring, hurried"
  },
  {
   "id": "s08_04_cat",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "cat",
   "text": "That's what they all say right before an abduction.",
   "pauseAfter": 0.45
  },
  {
   "id": "s08_05_7",
   "scene": 8,
   "dir": "s08_boarding",
   "speaker": "seven",
   "text": "Get in!",
   "pauseAfter": 0.45,
   "delivery": "laughs"
  },
  {
   "id": "s09_01_cat",
   "scene": 9,
   "dir": "s09_interior",
   "speaker": "cat",
   "text": "This is considerably more ship than I was expecting.",
   "pauseAfter": 0.45
  },
  {
   "id": "s09_02_7",
   "scene": 9,
   "dir": "s09_interior",
   "speaker": "seven",
   "text": "Is that a complaint?",
   "pauseAfter": 0.45,
   "delivery": "amused"
  },
  {
   "id": "s09_03_cat",
   "scene": 9,
   "dir": "s09_interior",
   "speaker": "cat",
   "text": "I'm reserving judgment until I find the kitchen.",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_01_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "So what do you eat? Canned food?",
   "pauseAfter": 0.45,
   "delivery": "playful"
  },
  {
   "id": "s10_02_cat",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "cat",
   "text": "Chicken. But only free-range.",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_03_cat",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "cat",
   "text": "Having experienced confinement, I feel strongly about it.",
   "pauseAfter": 1.4
  },
  {
   "id": "s10_04_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "I'll see what we have.",
   "pauseAfter": 6.0,
   "delivery": "warm, amused"
  },
  {
   "id": "s10_05_cat",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "cat",
   "text": "You're letting it get cold.",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_06_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "Those others…",
   "pauseAfter": 0.45,
   "delivery": "quiet, distant"
  },
  {
   "id": "s10_07_cat",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "cat",
   "text": "At the door?",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_08_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "They were just going somewhere. Like it was an ordinary day.",
   "pauseAfter": 0.45,
   "delivery": "thoughtful, soft"
  },
  {
   "id": "s10_09_cat",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "cat",
   "text": "Perhaps it was.",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_10_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "The walls were whole. Everything was… looked after.",
   "pauseAfter": 0.45,
   "delivery": "softly, remembering"
  },
  {
   "id": "s10_11_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "One of them opened the door. I watched where they put their hand.",
   "pauseAfter": 0.45,
   "delivery": "quiet, careful"
  },
  {
   "id": "s10_12_cat",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "cat",
   "text": "Useful.",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_13_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "Yes.",
   "pauseAfter": 3.0,
   "delivery": "softly"
  },
  {
   "id": "s10_14_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "But it didn't feel like seeing somewhere new.",
   "pauseAfter": 0.45,
   "delivery": "hesitant, quiet"
  },
  {
   "id": "s10_15_cat",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "cat",
   "text": "What did it feel like?",
   "pauseAfter": 1.8
  },
  {
   "id": "s10_16_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "Remembering.",
   "pauseAfter": 4.0,
   "delivery": "quiet, wondering"
  },
  {
   "id": "s10_17_cat",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "cat",
   "text": "Have you been there before?",
   "pauseAfter": 0.45
  },
  {
   "id": "s10_18_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "I don't know.",
   "pauseAfter": 0.45,
   "delivery": "honest, quiet"
  },
  {
   "id": "s10_19_7",
   "scene": 10,
   "dir": "s10_galley",
   "speaker": "seven",
   "text": "It happened when I touched this.",
   "pauseAfter": 0.45,
   "delivery": "soft, curious"
  },
  {
   "id": "s10_20_cat",
   "scene": 10,
